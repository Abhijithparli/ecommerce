<% const currentUser = (typeof user !== 'undefined' && user) ? user : null; %>
<% const flashError = (typeof error !== 'undefined' && error) ? error : null; %>
<% const flashSuccess = (typeof success !== 'undefined' && success) ? success : null; %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HeadShield - Shop Helmets</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0a0a0f] text-gray-200 min-h-screen flex flex-col">

  <!-- Include Header -->
  <%- include("../partials/user/header", { user: currentUser }) %>

  <!-- Main Shopping Section -->
  <div class="max-w-7xl mx-auto px-6 py-10 w-full flex-1 flex flex-col lg:flex-row gap-8">
    
    <!-- Left Sidebar: Figma-style Filters -->
    <aside class="w-full lg:w-64 bg-[#13131a] border border-white/5 rounded-2xl p-6 h-fit shrink-0 space-y-8">
      
      <!-- Filter Form -->
      <form action="/products" method="GET" id="filterForm" class="space-y-6">
        <!-- Maintain search & sort query inputs if they exist -->
        <input type="hidden" name="search" value="<%= search %>">
        <input type="hidden" name="sort" value="<%= sort %>">
        
        <!-- Categories Checklist -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-white/5 pb-2">Categories</h3>
          <div class="space-y-3">
            <% categories.forEach(cat => { %>
              <% 
                const isChecked = (typeof selectedCategories !== 'undefined' && Array.isArray(selectedCategories))
                  ? (selectedCategories.includes(cat._id.toString()) || selectedCategories.some(c => c.toLowerCase() === cat.name.toLowerCase()))
                  : (category === cat._id.toString() || (category && category.toLowerCase() === cat.name.toLowerCase()));
              %>
              <label class="flex items-center gap-3 text-sm text-gray-400 hover:text-white cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  name="category" 
                  value="<%= cat._id %>" 
                  class="rounded bg-zinc-800 border-zinc-700 text-orange-500 focus:ring-0 focus:ring-offset-0 w-4 h-4 cursor-pointer"
                  <%= isChecked ? 'checked' : '' %>
                  onchange="this.form.submit()"
                >
                <span><%= cat.name %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Brands Checklist -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-white/5 pb-2">Brands</h3>
          <div class="space-y-3">
            <% brands.forEach(b => { %>
              <label class="flex items-center gap-3 text-sm text-gray-400 hover:text-white cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  name="brand" 
                  value="<%= b %>" 
                  class="rounded bg-zinc-800 border-zinc-700 text-orange-500 focus:ring-0 focus:ring-offset-0 w-4 h-4 cursor-pointer"
                  <%= brand === b ? 'checked' : '' %>
                  onchange="this.form.submit()"
                >
                <span><%= b %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Price Range Filter -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-white/5 pb-2">Price</h3>
          <div class="space-y-3">
            <label class="flex items-center gap-3 text-sm text-gray-400 hover:text-white cursor-pointer select-none">
              <input 
                type="radio" 
                name="price" 
                value="0-1000" 
                class="bg-zinc-800 border-zinc-700 text-orange-500 focus:ring-0 focus:ring-offset-0 w-4 h-4 cursor-pointer"
                <%= price === '0-1000' ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              <span>Under ₹1000</span>
            </label>
            <label class="flex items-center gap-3 text-sm text-gray-400 hover:text-white cursor-pointer select-none">
              <input 
                type="radio" 
                name="price" 
                value="1000-3000" 
                class="bg-zinc-800 border-zinc-700 text-orange-500 focus:ring-0 focus:ring-offset-0 w-4 h-4 cursor-pointer"
                <%= price === '1000-3000' ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              <span>₹1000 - ₹3000</span>
            </label>
            <label class="flex items-center gap-3 text-sm text-gray-400 hover:text-white cursor-pointer select-none">
              <input 
                type="radio" 
                name="price" 
                value="3000-above" 
                class="bg-zinc-800 border-zinc-700 text-orange-500 focus:ring-0 focus:ring-offset-0 w-4 h-4 cursor-pointer"
                <%= price === '3000-above' ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              <span>Above ₹3000</span>
            </label>
          </div>
        </div>

        <!-- Clear Filters Button -->
        <a href="/products" class="block text-center border border-zinc-700 text-sm hover:bg-zinc-800 text-white font-semibold py-2.5 rounded-lg transition duration-200 text-decoration-none">
          Clear Filters
        </a>

      </form>
    </aside>

    <!-- Right Container: Catalog & Banners -->
    <main class="flex-1 flex flex-col gap-6">

      <!-- Dynamic Category Banners -->
      <% 
        let bannerSrc = "";
        let taglineText = "Revolutionary Security within reach of all types of Riders.";
        
        const activeCategories = (typeof selectedCategories !== 'undefined' && Array.isArray(selectedCategories)) ? selectedCategories : (category ? [category] : []);
        const activeCat = categories.find(c => activeCategories.includes(c._id.toString()) || activeCategories.some(ac => ac.toLowerCase() === c.name.toLowerCase()));
        if (activeCat) {
          const catName = activeCat.name.toUpperCase();
          if (catName.includes("APEX")) {
            bannerSrc = "/img/axor1.webp";
            taglineText = "Experts In safety homologation. Gear up with the best.";
          } else if (catName.includes("CROSS")) {
            bannerSrc = "/img/axor_X_cross_720x.webp";
            taglineText = "The terrain may test you, but your helmet ensures you stay in control.";
          } else if (catName.includes("RETRO")) {
            bannerSrc = "/img/retrobest.webp";
            taglineText = "Vintage looks combined with modern safety standards.";
          }
        }
      %>

      <!-- Dynamic Top Banner -->
      <% if (bannerSrc && activeCat) { %>
        <div class="relative w-full h-48 rounded-2xl overflow-hidden border border-white/5 shadow-2xl">
          <img src="<%= bannerSrc %>" alt="Category Banner" class="w-full h-full object-cover opacity-80">
          <div class="absolute inset-0 bg-gradient-to-r from-black/80 to-transparent flex items-center px-8">
            <div class="space-y-2">
              <span class="bg-orange-500 text-white text-[10px] font-bold tracking-wider px-2 py-0.5 rounded uppercase">Featured Category</span>
              <h2 class="text-2xl font-bold text-white tracking-wide uppercase"><%= activeCat.name %></h2>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Subheader Tagline -->
      <div class="bg-[#13131a] border border-white/5 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1">
          <p class="text-gray-400 text-xs tracking-wider uppercase font-semibold">HeadShield Protection</p>
          <h2 class="text-lg font-bold text-white tracking-wide"><%= taglineText %></h2>
        </div>
        
        <!-- Search & Sorting controls -->
        <form action="/products" method="GET" class="flex items-center gap-3 w-full sm:w-auto">
          <% if (typeof selectedCategories !== 'undefined' && Array.isArray(selectedCategories) && selectedCategories.length > 0) { %>
            <% selectedCategories.forEach(catVal => { %>
              <input type="hidden" name="category" value="<%= catVal %>">
            <% }) %>
          <% } else if (category) { %>
            <input type="hidden" name="category" value="<%= category %>">
          <% } %>
          <input type="hidden" name="brand" value="<%= brand %>">
          <input type="hidden" name="price" value="<%= price %>">
          
          <!-- Search Bar -->
          <div class="relative flex-1 sm:w-60">
            <input 
              type="text" 
              name="search" 
              value="<%= search %>" 
              placeholder="Search catalog..." 
              class="w-full bg-zinc-800 border border-zinc-700 rounded-lg pl-4 pr-10 py-2 text-sm text-white focus:outline-none focus:border-orange-500 transition duration-200"
            >
            <% if (search) { %>
              <% 
                const clearSearchCatPart = (typeof categoryQueryString !== 'undefined' && categoryQueryString) ? `&${categoryQueryString}` : (category ? `&category=${category}` : '');
              %>
              <a href="/products?brand=<%= brand %>&price=<%= price %><%= clearSearchCatPart %>" class="absolute right-3 top-2.5 text-xs text-gray-500 hover:text-white" title="Clear Search">✕</a>
            <% } %>
          </div>

          <!-- Sorting Selector -->
          <select 
            name="sort" 
            class="bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500 transition duration-200"
            onchange="this.form.submit()"
          >
            <option value="">Sort By</option>
            <option value="low-high" <%= sort === 'low-high' ? 'selected' : '' %>>Price Low to High</option>
            <option value="high-low" <%= sort === 'high-low' ? 'selected' : '' %>>Price High to Low</option>
            <option value="a-z" <%= sort === 'a-z' ? 'selected' : '' %>>A-Z</option>
            <option value="z-a" <%= sort === 'z-a' ? 'selected' : '' %>>Z-A</option>
          </select>
        </form>
      </div>

      <!-- Flash Message Alerts -->
      <% if (flashError) { %>
        <div class="bg-red-500/15 border border-red-500/30 text-red-400 px-4 py-3 rounded-xl text-sm font-medium">
          <%= flashError %>
        </div>
      <% } %>
      <% if (flashSuccess) { %>
        <div class="bg-green-500/15 border border-green-500/30 text-green-400 px-4 py-3 rounded-xl text-sm font-medium">
          <%= flashSuccess %>
        </div>
      <% } %>

      <!-- Product Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="bg-[#13131a] border border-white/5 rounded-2xl overflow-hidden hover:scale-[1.02] transition duration-300 flex flex-col group relative">
              
              <!-- Wishlist icon placeholder -->
              <button 
                onclick="handleGuestAction(event, 'wishlist')" 
                class="absolute top-4 right-4 z-10 w-9 h-9 bg-black/60 rounded-full border border-white/10 flex items-center justify-center text-gray-400 hover:text-red-500 transition duration-200 text-lg shadow-lg"
                title="Save product"
              >
                ♡
              </button>

              <!-- Image Container -->
              <div class="w-full h-56 bg-zinc-950 overflow-hidden flex items-center justify-center p-4">
                <img 
                  src="<%= product.images && product.images[0] ? product.images[0] : '/img/targo-pro-biger.jpg' %>" 
                  alt="<%= product.name %>"
                  class="max-w-full max-h-full object-contain group-hover:scale-105 transition duration-300"
                >
              </div>

              <!-- Product Info -->
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div class="space-y-1">
                  <!-- Star Ratings -->
                  <div class="flex items-center gap-1 text-emerald-400 text-xs">
                    ★ ★ ★ ★ ☆
                    <span class="text-gray-500 ml-1">(4.0)</span>
                  </div>
                  <h3 class="text-white font-bold tracking-wide text-base group-hover:text-orange-500 transition duration-200 line-clamp-1">
                    <%= product.name %>
                  </h3>
                  <p class="text-xs text-gray-500"><%= product.brand %> • <%= product.category?.name %></p>
                </div>

                <div class="mt-4 pt-4 border-t border-white/5">
                  <!-- Pricing and Off Label -->
                  <%
                    let cardDisplayPrice = '';
                    if (product.variants && product.variants.length > 0) {
                      const prices = product.variants.map(v => v.price).filter(p => typeof p === 'number' && !isNaN(p));
                      if (prices.length > 0) {
                        const minP = Math.min(...prices);
                        const maxP = Math.max(...prices);
                        cardDisplayPrice = minP === maxP ? `₹${minP}` : `₹${minP} - ₹${maxP}`;
                      }
                    }
                    if (!cardDisplayPrice) {
                      cardDisplayPrice = `₹${product.salePrice || product.regularPrice || 0}`;
                    }
                  %>
                  <div class="flex items-baseline gap-2 flex-wrap">
                    <span class="text-lg font-bold text-orange-500"><%= cardDisplayPrice %></span>
                    <% if (product.regularPrice > product.salePrice) { %>
                      <span class="text-gray-500 line-through text-xs">₹<%= product.regularPrice %></span>
                      <span class="text-red-500 text-xs font-bold font-mono">
                        <%= Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100) %>% OFF
                      </span>
                    <% } %>
                  </div>
                  
                  <!-- Free Delivery Badge -->
                  <p class="text-[11px] text-emerald-400 font-semibold mt-1">Free Delivery</p>

                  <!-- Button Link -->
                  <a 
                    href="/products/<%= product._id %>" 
                    class="block text-center bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm py-2.5 rounded-lg mt-4 transition duration-200 text-decoration-none"
                  >
                    View Product
                  </a>
                </div>
              </div>

            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center py-20 bg-[#13131a] border border-white/5 rounded-2xl">
            <h2 class="text-xl font-semibold text-gray-500">No Products Found</h2>
            <p class="text-sm text-gray-600 mt-2">Try adjusting your filters or search terms.</p>
          </div>
        <% } %>
      </div>

      <!-- Pagination Component -->
      <% if (totalPages > 1) { %>
        <% 
          const catQueryPart = (typeof categoryQueryString !== 'undefined' && categoryQueryString) ? `&${categoryQueryString}` : (category ? `&category=${category}` : '');
        %>
        <div class="flex justify-center mt-6">
          <nav aria-label="Page navigation">
            <ul class="pagination flex items-center gap-1">
              <!-- PREVIOUS -->
              <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a 
                  class="page-link" 
                  href="/products?page=<%= currentPage - 1 %>&search=<%= search %><%= catQueryPart %>&sort=<%= sort %>&price=<%= price %>&brand=<%= brand %>"
                >
                  Previous
                </a>
              </li>

              <!-- PAGE NUMBERS -->
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                  <a 
                    class="page-link" 
                    href="/products?page=<%= i %>&search=<%= search %><%= catQueryPart %>&sort=<%= sort %>&price=<%= price %>&brand=<%= brand %>"
                  >
                    <%= i %>
                  </a>
                </li>
              <% } %>

              <!-- NEXT -->
              <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a 
                  class="page-link" 
                  href="/products?page=<%= currentPage + 1 %>&search=<%= search %><%= catQueryPart %>&sort=<%= sort %>&price=<%= price %>&brand=<%= brand %>"
                >
                  Next
                </a>
              </li>
            </ul>
          </nav>
        </div>
      <% } %>

    </main>

  </div>

  <!-- Include Footer -->
  <%- include("../partials/user/footer") %>

  <!-- Styles to ensure Bootstrap-style classes map perfectly -->
  <style>
    .pagination {
      display: flex;
      padding-left: 0;
      list-style: none;
    }
    .page-item {
      margin: 0 2px;
    }
    .page-link {
      position: relative;
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: #9ca3af; /* text-gray-400 */
      background-color: #13131a;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 0.375rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .page-link:hover {
      color: #ffffff;
      background-color: #1e1e24;
      border-color: #f97316;
    }
    .page-item.active .page-link {
      color: #ffffff;
      background-color: #f97316;
      border-color: #f97316;
    }
    .page-item.disabled .page-link {
      color: #4b5563; /* text-gray-600 */
      pointer-events: none;
      background-color: #0d0d14;
      border-color: rgba(255,255,255,0.03);
      opacity: 0.5;
    }
  </style>

</body>
</html>