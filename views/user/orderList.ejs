<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Orders - Headshield</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500&display=swap');
  * { font-family: 'DM Sans', sans-serif; }
  h1, .brand { font-family: 'Rajdhani', sans-serif; }

  body { background: #0a0a0f; color: #e5e5e5; }

  .sidebar {
    background: linear-gradient(160deg, #111118, #0d0d14);
    border-right: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-link {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 16px; border-radius: 8px;
    color: #9ca3af; font-size: 14px;
    transition: all 0.2s; cursor: pointer; text-decoration: none;
  }
  .sidebar-link:hover, .sidebar-link.active {
    background: rgba(249,115,22,0.12);
    color: #f97316;
  }
  .sidebar-link.active { border-left: 3px solid #f97316; padding-left: 13px; }

  .card {
    background: #13131a;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
  }

  .topbar {
    background: #0d0d14;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 14px 24px;
    display: flex; align-items: center; justify-content: space-between;
  }
  
  .badge-placed { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
  .badge-shipped { background: rgba(249, 115, 22, 0.15); color: #f97316; }
  .badge-delivered { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .badge-cancelled { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .badge-returned { background: rgba(107, 114, 128, 0.15); color: #9ca3af; }
</style>
</head>
<body class="min-h-screen flex flex-col">

<!-- Top Bar -->
<div class="topbar">
  <div class="flex items-center gap-3">
    <span class="brand text-2xl font-bold text-orange-500">Headshield</span>
    <span class="text-gray-600 text-sm">/ My Orders</span>
  </div>
  <div class="flex items-center gap-4">
    <a href="/" class="text-gray-400 hover:text-white text-sm transition">← Back to Store</a>
    <form action="/logout" method="POST" class="inline m-0">
      <button class="text-sm text-red-400 hover:text-red-300 transition bg-transparent border-0 cursor-pointer">Logout</button>
    </form>
  </div>
</div>

<!-- Layout -->
<div class="flex flex-1 max-w-6xl mx-auto w-full px-4 py-8 gap-6">

  <!-- Sidebar -->
  <aside class="sidebar w-56 shrink-0 rounded-xl p-4 h-fit sticky top-8">
    <div class="text-xs text-gray-600 uppercase tracking-widest mb-3 px-2">Account</div>
    <a href="/profile" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      My Profile
    </a>
    <a href="/profile/addresses" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Addresses
    </a>
    <a href="/profile/change-password" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      Change Password
    </a>
    <div class="border-t border-white/5 mt-3 pt-3">
      <a href="/profile/orders" class="sidebar-link active">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        My Orders
      </a>
    </div>
  </aside>

  <!-- Main -->
  <main class="flex-1 flex flex-col gap-6">
    <h2 class="text-2xl font-bold text-white mb-2">My Orders</h2>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-4">
        <% orders.forEach(order => { %>
          <div class="card p-6 flex flex-col sm:flex-row justify-between gap-6 items-start sm:items-center">
            
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-gray-400"><%= order.orderId %></span>
                <span class="px-2.5 py-1 text-xs font-bold rounded-lg uppercase tracking-wider badge-<%= order.status.toLowerCase() %>">
                  <%= order.status %>
                </span>
              </div>
              
              <!-- Simple horizontal thumbnails list -->
              <div class="flex gap-2">
                <% order.items.forEach(item => { %>
                  <img src="<%= item.image %>" class="w-12 h-12 object-cover rounded-lg border border-white/10" title="<%= item.name %>">
                <% }) %>
              </div>
              
              <div class="text-sm text-gray-500">
                Placed on: <span class="text-gray-300 font-medium"><%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></span>
              </div>
            </div>

            <!-- Price & Button -->
            <div class="text-left sm:text-right flex flex-row sm:flex-col justify-between items-center sm:items-end w-full sm:w-auto pt-4 sm:pt-0 border-t sm:border-t-0 border-white/5 gap-4">
              <div>
                <p class="text-xs text-gray-500">Grand Total</p>
                <h4 class="text-2xl font-extrabold text-orange-500 mt-1">₹<%= order.finalPrice %></h4>
              </div>
              <a href="/profile/orders/<%= order._id %>" class="px-5 py-2.5 bg-white/10 hover:bg-white/15 text-white font-semibold rounded-lg text-sm transition">
                View Details
              </a>
            </div>

          </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="flex justify-center items-center gap-3 mt-6">
          <% if (currentPage > 1) { %>
            <a href="/profile/orders?page=<%= currentPage - 1 %>" class="px-4 py-2 bg-white/5 hover:bg-white/10 text-white rounded-lg text-sm transition">Previous</a>
          <% } %>
          <span class="text-sm text-gray-400">Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="/profile/orders?page=<%= currentPage + 1 %>" class="px-4 py-2 bg-white/5 hover:bg-white/10 text-white rounded-lg text-sm transition">Next</a>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <!-- No Orders State -->
      <div class="card p-12 text-center border-dashed">
        <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-300 mb-2">No Orders Yet</h3>
        <p class="text-gray-500 mb-6 max-w-sm mx-auto text-sm leading-relaxed">You haven't purchased any helmets yet. Browse our collection to find the perfect gear!</p>
        <a href="/products" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-md">
          Browse Products
        </a>
      </div>
    <% } %>

  </main>
</div>

</body>
</html>
