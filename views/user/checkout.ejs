<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Checkout - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body class="bg-gray-100 min-h-screen font-sans">

  <!-- HEADER -->
  <%- include('../partials/user/header') %>

  <div class="max-w-7xl mx-auto px-6 py-10">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-10">Checkout</h1>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 bg-green-100 border border-green-300 rounded-xl text-green-700 text-sm">✓ <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 bg-red-100 border border-red-300 rounded-xl text-red-700 text-sm">⚠️ <%= error %></div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <!-- LEFT COLUMN: ADDRESS & PAYMENT -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- ADDRESS SECTION -->
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Select Delivery Address</h2>
            <button type="button" onclick="openAddressModal()" class="text-orange-500 hover:text-orange-600 font-semibold transition text-sm">
              + Add New Address
            </button>
          </div>

          <% if (addresses && addresses.length > 0) { %>
            <div class="space-y-4">
              <% addresses.forEach((addr, index) => { %>
                <label class="block cursor-pointer">
                  <input type="radio" name="selectedAddress" value="<%= addr._id %>" data-name="<%= addr.name %>" data-phone="<%= addr.phone %>" class="sr-only peer" <%= addr.isDefault ? 'checked' : '' %>>
                  <div class="p-5 rounded-xl border-2 border-gray-200 peer-checked:border-orange-500 peer-checked:bg-orange-50/30 hover:border-gray-300 transition duration-150 relative">
                    
                    <!-- Checked Indicator -->
                    <div class="absolute top-4 right-4 text-orange-500 hidden peer-checked:block">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>

                    <div class="flex items-center gap-3 mb-2">
                      <span class="px-2.5 py-1 bg-gray-100 text-gray-800 rounded-md text-xs font-semibold uppercase tracking-wider">
                        <%= addr.type || 'Address' %>
                      </span>
                      <% if (addr.isDefault) { %>
                        <span class="px-2.5 py-1 bg-orange-100 text-orange-800 rounded-md text-xs font-semibold">
                          Default
                        </span>
                      <% } %>
                    </div>
                    
                    <h3 class="font-bold text-gray-800 text-lg mb-1"><%= addr.name %></h3>
                    <p class="text-gray-600 leading-relaxed text-sm">
                      <%= addr.street %>, <%= addr.city %>, <%= addr.state %> - <strong class="text-gray-900"><%= addr.pincode %></strong>
                    </p>
                    <p class="text-gray-500 text-sm mt-2">
                      📞 Phone: <span class="font-medium text-gray-700"><%= addr.phone %></span>
                      <% if (addr.altphone) { %> | Alt: <%= addr.altphone %> <% } %>
                    </p>
                    <button type="button"
                      data-address="<%= JSON.stringify({ _id: addr._id, name: addr.name, phone: addr.phone, street: addr.street, city: addr.city, state: addr.state, pincode: addr.pincode, isDefault: addr.isDefault }) %>"
                      onclick="event.preventDefault(); openAddressModal(JSON.parse(this.dataset.address))"
                      class="mt-3 text-sm font-semibold text-orange-500 hover:text-orange-600 transition">
                      Edit
                    </button>
                  </div>
                </label>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-10 bg-gray-50 rounded-xl border border-dashed border-gray-300">
              <p class="text-gray-500 mb-4">No shipping addresses found in your profile.</p>
              <button type="button" onclick="openAddressModal()" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-md">
                Add New Address
              </button>
            </div>
          <% } %>
        </div>

        <!-- PAYMENT METHOD SECTION -->
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Payment Method</h2>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              100% Secure Checkout
            </span>
          </div>
          
          <div class="space-y-4">
            
            <!-- Cash on Delivery (COD) -->
            <label class="block cursor-pointer" onclick="updatePaymentUI()">
              <input type="radio" name="paymentMethod" value="COD" checked class="sr-only" onchange="updatePaymentUI()">
              <div id="card-COD" class="p-5 rounded-xl border-2 border-orange-500 bg-orange-50/40 shadow-sm transition duration-150 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <!-- Custom Visible Radio Circle -->
                  <div id="radio-COD" class="w-5 h-5 rounded-full border-2 border-orange-500 flex items-center justify-center shrink-0">
                    <div class="w-2.5 h-2.5 rounded-full bg-orange-500"></div>
                  </div>
                  <div class="p-3 bg-orange-100 text-orange-600 rounded-xl shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-800 text-lg">Cash on Delivery (COD)</h3>
                    <p class="text-gray-500 text-sm">Pay in cash when your helmet is delivered.</p>
                  </div>
                </div>
                <div id="check-COD" class="text-orange-500 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </label>

            <!-- Razorpay Online Payment -->
            <label class="block cursor-pointer" onclick="updatePaymentUI()">
              <input type="radio" name="paymentMethod" value="Razorpay" class="sr-only" onchange="updatePaymentUI()">
              <div id="card-Razorpay" class="p-5 rounded-xl border-2 border-gray-200 bg-white hover:border-gray-300 transition duration-150 flex items-center justify-between gap-4">
                <div class="flex items-start sm:items-center gap-4">
                  <!-- Custom Visible Radio Circle -->
                  <div id="radio-Razorpay" class="w-5 h-5 mt-1 sm:mt-0 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0">
                    <div class="w-2.5 h-2.5 rounded-full bg-orange-500 hidden"></div>
                  </div>
                  <div class="p-3 bg-blue-100 text-blue-600 rounded-xl shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-bold text-gray-800 text-lg">Online Payment (Razorpay)</h3>
                      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">
                        Instant
                      </span>
                    </div>
                    <p class="text-gray-500 text-sm mt-0.5">Pay securely via UPI, Debit/Credit Cards, Netbanking, or Wallets.</p>
                    <!-- Supported Payment Method Badges -->
                    <div class="flex flex-wrap items-center gap-1.5 mt-2.5">
                      <span class="px-2 py-0.5 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200 rounded">UPI</span>
                      <span class="px-2 py-0.5 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200 rounded">GPay / PhonePe</span>
                      <span class="px-2 py-0.5 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200 rounded">Visa / Mastercard</span>
                      <span class="px-2 py-0.5 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200 rounded">RuPay</span>
                      <span class="px-2 py-0.5 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200 rounded">Netbanking</span>
                    </div>
                  </div>
                </div>
                <div id="check-Razorpay" class="text-orange-500 hidden shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </label>

            <!-- Wallet Payment Option -->
            <%
              const userWalletBal = (typeof walletBalance !== 'undefined' && typeof walletBalance === 'number') ? walletBalance : 0;
              const curDiscount = (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.discount : 0;
              const curPayable = Math.max(0, total - curDiscount);
              const canPayWallet = userWalletBal >= curPayable;
            %>
            <label class="block cursor-pointer" onclick="handleWalletLabelClick()">
              <input 
                type="radio" 
                name="paymentMethod" 
                value="Wallet" 
                class="sr-only" 
                id="walletRadioInput"
                <%= canPayWallet ? '' : 'disabled' %>
                onchange="updatePaymentUI()"
              >
              <div id="card-Wallet" class="p-5 rounded-xl border-2 border-gray-200 bg-white hover:border-gray-300 transition duration-150 flex items-center justify-between gap-4 <%= canPayWallet ? '' : 'opacity-60 bg-gray-50' %>">
                <div class="flex items-start sm:items-center gap-4">
                  <!-- Custom Radio Circle -->
                  <div id="radio-Wallet" class="w-5 h-5 mt-1 sm:mt-0 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0">
                    <div class="w-2.5 h-2.5 rounded-full bg-orange-500 hidden"></div>
                  </div>
                  <div class="p-3 bg-emerald-100 text-emerald-600 rounded-xl shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-bold text-gray-800 text-lg">HeadShield Wallet</h3>
                      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                        1-Click Instant
                      </span>
                    </div>
                    <p class="text-gray-500 text-sm mt-0.5 flex items-center gap-1.5 flex-wrap">
                      <span>Available Balance:</span>
                      <strong class="<%= canPayWallet ? 'text-emerald-600' : 'text-red-500' %> font-mono text-base">₹<span id="walletBalDisplay"><%= userWalletBal %></span></strong>
                      <span id="walletInsufficientWarning" class="<%= canPayWallet ? 'hidden' : 'inline' %> text-xs text-red-500 font-semibold bg-red-50 px-2 py-0.5 rounded border border-red-200 ml-1">
                        Insufficient funds for this order
                      </span>
                    </p>
                  </div>
                </div>
                <div id="check-Wallet" class="text-orange-500 hidden shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </label>

          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY -->
      <div>
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200 sticky top-28 space-y-6">
          <h2 class="text-2xl font-bold text-gray-800 pb-4 border-b border-gray-100">Order Summary</h2>

          <!-- ITEMS SUMMARY LIST -->
          <div class="max-h-60 overflow-y-auto divide-y divide-gray-100 pr-2">
            <% cart.items.forEach(item => { %>
              <%
                const variant = item.product.variants ? item.product.variants.find(v => v.size === item.size) : null;
                const itemUnitPrice = (variant && typeof variant.price === 'number') ? variant.price : (item.product.salePrice || 0);
                const status = itemStatus[item._id.toString()] || { available: true, message: "" };
              %>
              <div class="flex gap-4 py-4 first:pt-0 last:pb-0">
                <img src="<%= item.product.images[0] %>" class="w-16 h-16 object-cover rounded-lg border border-gray-200 <%= status.available ? '' : 'opacity-50 grayscale' %>">
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold text-gray-800 text-sm truncate"><%= item.product.name %></h4>
                  <p class="text-gray-500 text-xs mt-1">Size: <span class="font-semibold text-gray-700"><%= item.size %></span> | Qty: <span class="font-semibold"><%= item.quantity %></span></p>
                  <% if (!status.available) { %>
                    <p class="text-red-600 text-xs font-semibold mt-1"><%= status.message %></p>
                  <% } %>
                </div>
                <div class="text-right">
                  <span class="font-bold text-gray-900 text-sm">₹<%= itemUnitPrice * item.quantity %></span>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- COUPON SECTION -->
          <div class="py-4 border-t border-gray-100">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-gray-700 uppercase tracking-wider flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                Have a Coupon?
              </span>
              <button
                type="button"
                onclick="openAvailableCouponsModal()"
                class="text-xs font-semibold text-orange-600 hover:text-orange-700 underline cursor-pointer"
              >
                Available Coupons
              </button>
            </div>

            <!-- Coupon Input Box -->
            <div id="couponInputContainer" class="<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? 'hidden' : 'flex' %> gap-2">
              <input
                type="text"
                id="couponCodeInput"
                placeholder="ENTER COUPON CODE"
                class="flex-1 px-4 py-2.5 rounded-xl border border-gray-300 text-sm font-mono uppercase focus:outline-none focus:ring-2 focus:ring-orange-500"
                oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '')"
              >
              <button
                type="button"
                id="applyCouponBtn"
                onclick="applyCoupon()"
                class="bg-gray-900 hover:bg-gray-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition shrink-0"
              >
                Apply
              </button>
            </div>

            <!-- Applied Coupon Display Badge -->
            <div id="appliedCouponBadge" class="<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? 'flex' : 'hidden' %> p-3 bg-green-50 border border-green-200 rounded-xl items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold">✓</span>
                <div>
                  <span id="appliedCouponName" class="font-mono font-bold text-green-900 text-sm"><%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.code : '' %></span>
                  <span class="text-xs text-green-700 block">Coupon applied successfully!</span>
                </div>
              </div>
              <button
                type="button"
                onclick="removeCoupon()"
                class="text-xs text-red-600 hover:text-red-800 font-bold px-2 py-1 hover:bg-red-50 rounded-lg transition"
              >
                Remove
              </button>
            </div>
          </div>

          <!-- BREAKDOWN -->
          <div class="space-y-3 pt-4 border-t border-gray-100 text-sm text-gray-600">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span class="font-semibold text-gray-800">₹<span id="subtotalDisplay"><%= total %></span></span>
            </div>
            <div id="discountRow" class="<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon && appliedCoupon.discount > 0) ? 'flex' : 'hidden' %> justify-between text-green-600 font-semibold">
              <span>Coupon Discount (<span id="discountCouponCode"><%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.code : '' %></span>)</span>
              <span>- ₹<span id="discountDisplay"><%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.discount : '0' %></span></span>
            </div>
            <div class="flex justify-between">
              <span>Delivery Fee</span>
              <span class="text-green-600 font-semibold uppercase text-xs">Free</span>
            </div>
            
            <div class="flex justify-between text-lg font-bold text-gray-900 pt-3 border-t border-gray-100">
              <span>Grand Total</span>
              <% 
                const initialDiscount = (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.discount : 0;
                const initialFinal = Math.max(0, total - initialDiscount);
              %>
              <span class="text-2xl text-orange-600">₹<span id="grandTotalDisplay"><%= initialFinal %></span></span>
            </div>
          </div>

          <!-- PLACE ORDER BUTTON -->
          <% if (hasUnavailableItems) { %>
            <div class="p-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
              Some items are out of stock or unavailable.
              <a href="/cart" class="font-semibold underline">Update your cart</a> to place the order.
            </div>
            <button type="button" disabled class="w-full bg-gray-300 text-gray-500 font-bold py-4 rounded-xl cursor-not-allowed">
              Place Order (Cash on Delivery)
            </button>
          <% } else { %>
            <button id="placeOrderBtn" onclick="submitOrder()" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-2">
              Place Order (Cash on Delivery)
            </button>
          <% } %>
        </div>
      </div>

    </div>
  </div>

  <!-- Add / Edit address without leaving checkout -->
  <%- include('../partials/user/addressModal', { redirectTo: '/checkout' }) %>

  <!-- FOOTER -->
  <%- include('../partials/user/footer') %>

  <!-- JAVASCRIPT FOR SUBMITTING ORDER -->
  <script>
    let appliedCouponCode = "<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.code : '' %>";
    let currentDiscount = Number("<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.discount : 0 %>");
    let currentTotal = Number("<%= initialFinal %>");
    const userWalletBalance = Number("<%= (typeof walletBalance !== 'undefined' && typeof walletBalance === 'number') ? walletBalance : 0 %>");
    const LOGGED_IN_USER_EMAIL = "<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>";

    function getButtonLabel(method) {
      if (method === "Razorpay") {
        return `Proceed to Online Payment • ₹${currentTotal}`;
      } else if (method === "Wallet") {
        return `Pay ₹${currentTotal} with Wallet`;
      }
      return "Place Order (Cash on Delivery)";
    }

    function handleWalletLabelClick() {
      if (userWalletBalance < currentTotal) {
        Swal.fire({
          icon: "info",
          title: "Insufficient Wallet Balance",
          text: `Your wallet balance is ₹${userWalletBalance}, but order total is ₹${currentTotal}. Please choose another payment method.`,
          confirmButtonColor: "#f97316"
        });
        return;
      }
      const radio = document.getElementById("walletRadioInput");
      if (radio && !radio.disabled) {
        radio.checked = true;
        updatePaymentUI();
      }
    }

    function updatePaymentUI() {
      const selectedPaymentRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const method = selectedPaymentRadio ? selectedPaymentRadio.value : "COD";

      // Check if wallet can afford current total
      const walletRadio = document.getElementById("walletRadioInput");
      const walletWarning = document.getElementById("walletInsufficientWarning");
      const walletCard = document.getElementById("card-Wallet");
      const canAffordWallet = userWalletBalance >= currentTotal;

      if (walletRadio) {
        walletRadio.disabled = !canAffordWallet;
        if (!canAffordWallet && method === "Wallet") {
          const codRadio = document.querySelector('input[name="paymentMethod"][value="COD"]');
          if (codRadio) codRadio.checked = true;
        }
      }
      if (walletWarning) {
        walletWarning.classList.toggle("hidden", canAffordWallet);
      }
      if (walletCard && !canAffordWallet) {
        walletCard.classList.add("opacity-60", "bg-gray-50");
      }

      const activeMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || "COD";

      ["COD", "Wallet", "Razorpay"].forEach((key) => {
        const card = document.getElementById(`card-${key}`);
        const radioOuter = document.getElementById(`radio-${key}`);
        const radioDot = radioOuter ? radioOuter.querySelector("div") : null;
        const checkIcon = document.getElementById(`check-${key}`);
        const isSelected = activeMethod === key;

        if (card) {
          if (isSelected) {
            card.classList.remove("border-gray-200", "bg-white", "hover:border-gray-300", "opacity-60", "bg-gray-50");
            card.classList.add("border-orange-500", "bg-orange-50/40", "shadow-sm");
          } else {
            card.classList.remove("border-orange-500", "bg-orange-50/40", "shadow-sm");
            card.classList.add("border-gray-200", "bg-white", "hover:border-gray-300");
            if (key === "Wallet" && !canAffordWallet) {
              card.classList.add("opacity-60", "bg-gray-50");
            }
          }
        }
        if (radioOuter) {
          radioOuter.classList.toggle("border-orange-500", isSelected);
          radioOuter.classList.toggle("border-gray-300", !isSelected);
        }
        if (radioDot) {
          radioDot.classList.toggle("hidden", !isSelected);
        }
        if (checkIcon) {
          checkIcon.classList.toggle("hidden", !isSelected);
        }
      });

      const placeOrderBtn = document.getElementById("placeOrderBtn");
      if (placeOrderBtn && !placeOrderBtn.disabled) {
        placeOrderBtn.innerText = getButtonLabel(activeMethod);
      }
    }

    // Initialize UI state on page load
    document.addEventListener("DOMContentLoaded", updatePaymentUI);

    // ================= COUPON CLIENT LOGIC =================
    async function applyCoupon(codeOverride) {
      const input = document.getElementById("couponCodeInput");
      const code = (codeOverride || (input ? input.value : "")).trim().toUpperCase();

      if (!code) {
        Swal.fire({
          icon: "warning",
          title: "Enter Code",
          text: "Please enter a coupon code to apply.",
          confirmButtonColor: "#f97316"
        });
        return;
      }

      const applyBtn = document.getElementById("applyCouponBtn");
      if (applyBtn) {
        applyBtn.disabled = true;
        applyBtn.innerText = "Applying...";
      }

      try {
        const res = await fetch("/checkout/apply-coupon", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ couponCode: code })
        });
        const data = await res.json();

        if (data.success) {
          appliedCouponCode = data.couponCode;
          currentDiscount = data.discount;
          currentTotal = data.finalPrice;

          // Update UI
          document.getElementById("couponInputContainer").classList.add("hidden");
          document.getElementById("appliedCouponBadge").classList.remove("hidden");
          document.getElementById("appliedCouponBadge").classList.add("flex");
          document.getElementById("appliedCouponName").innerText = data.couponCode;

          document.getElementById("discountRow").classList.remove("hidden");
          document.getElementById("discountRow").classList.add("flex");
          document.getElementById("discountCouponCode").innerText = data.couponCode;
          document.getElementById("discountDisplay").innerText = data.discount;
          document.getElementById("grandTotalDisplay").innerText = data.finalPrice;

          updatePaymentUI();

          Swal.fire({
            icon: "success",
            title: "Coupon Applied!",
            text: `You saved ₹${data.discount} on this order!`,
            timer: 2000,
            showConfirmButton: false
          });
        } else {
          Swal.fire({
            icon: "error",
            title: "Coupon Error",
            text: data.message || "Could not apply coupon.",
            confirmButtonColor: "#f97316"
          });
        }
      } catch (err) {
        console.error("Apply coupon error:", err);
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Something went wrong while applying the coupon.",
          confirmButtonColor: "#f97316"
        });
      } finally {
        if (applyBtn) {
          applyBtn.disabled = false;
          applyBtn.innerText = "Apply";
        }
      }
    }

    async function removeCoupon() {
      try {
        const res = await fetch("/checkout/remove-coupon", {
          method: "POST",
          headers: { "Content-Type": "application/json" }
        });
        const data = await res.json();

        if (data.success) {
          appliedCouponCode = "";
          currentDiscount = 0;
          currentTotal = data.finalPrice;

          document.getElementById("couponInputContainer").classList.remove("hidden");
          document.getElementById("couponInputContainer").classList.add("flex");
          document.getElementById("appliedCouponBadge").classList.add("hidden");
          document.getElementById("appliedCouponBadge").classList.remove("flex");

          document.getElementById("discountRow").classList.add("hidden");
          document.getElementById("discountRow").classList.remove("flex");
          document.getElementById("discountDisplay").innerText = "0";
          document.getElementById("grandTotalDisplay").innerText = data.finalPrice;

          const input = document.getElementById("couponCodeInput");
          if (input) input.value = "";

          updatePaymentUI();

          Swal.fire({
            icon: "info",
            title: "Coupon Removed",
            text: "The coupon has been removed from your order.",
            timer: 1500,
            showConfirmButton: false
          });
        }
      } catch (err) {
        console.error("Remove coupon error:", err);
      }
    }

    async function openAvailableCouponsModal() {
      const modal = document.getElementById("availableCouponsModal");
      const container = document.getElementById("couponsListContainer");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      container.innerHTML = `<p class="text-center text-sm text-gray-400 py-6">Loading coupons...</p>`;

      try {
        const res = await fetch("/checkout/available-coupons");
        const data = await res.json();

        if (data.success && data.coupons && data.coupons.length > 0) {
          container.innerHTML = data.coupons.map(c => `
            <div class="p-4 rounded-2xl border ${c.isEligible ? 'border-orange-200 bg-orange-50/30 hover:border-orange-400 cursor-pointer' : 'border-gray-200 bg-gray-50 opacity-60'} transition"
                 onclick="${c.isEligible ? `selectCouponFromModal('${c.code}')` : ''}">
              <div class="flex items-center justify-between">
                <span class="font-mono font-bold text-orange-600 bg-white px-3 py-1 rounded-lg border border-orange-200 text-sm tracking-wider">${c.code}</span>
                <span class="text-xs font-bold ${c.isEligible ? 'text-green-600' : 'text-gray-500'}">
                  ${c.discountType === 'percentage' ? `${c.discountValue}% OFF` : `₹${c.discountValue} FLAT OFF`}
                </span>
              </div>
              <p class="text-xs text-gray-600 mt-2">
                ${c.minPurchase > 0 ? `Min purchase: ₹${c.minPurchase}` : 'No minimum purchase required'}
                ${c.maxDiscount ? ` • Max cap: ₹${c.maxDiscount}` : ''}
              </p>
              ${c.isEligible 
                ? `<div class="mt-2 text-right"><span class="text-xs text-orange-600 font-bold hover:underline">Click to Apply →</span></div>`
                : `<div class="mt-2 text-xs text-red-500 font-semibold">Add ₹${c.neededAmount} more to unlock this coupon</div>`
              }
            </div>
          `).join("");
        } else {
          container.innerHTML = `<p class="text-center text-sm text-gray-400 py-6">No coupons available right now.</p>`;
        }
      } catch (err) {
        container.innerHTML = `<p class="text-center text-sm text-red-500 py-6">Failed to load coupons.</p>`;
      }
    }

    function closeAvailableCouponsModal() {
      const modal = document.getElementById("availableCouponsModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    async function selectCouponFromModal(code) {
      closeAvailableCouponsModal();
      if (appliedCouponCode) {
        if (appliedCouponCode === code) {
          Swal.fire({
            icon: "info",
            title: "Already Applied",
            text: `Coupon "${code}" is already applied to this order.`,
            confirmButtonColor: "#f97316"
          });
          return;
        }

        const result = await Swal.fire({
          icon: "question",
          title: "Replace Coupon?",
          text: `Coupon "${appliedCouponCode}" is already applied. Only one coupon can be applied per order. Do you want to replace it with "${code}"?`,
          showCancelButton: true,
          confirmButtonText: "Yes, replace it",
          cancelButtonText: "Keep current coupon",
          confirmButtonColor: "#f97316"
        });

        if (!result.isConfirmed) return;
        await removeCoupon();
      }
      const input = document.getElementById("couponCodeInput");
      if (input) input.value = code;
      applyCoupon(code);
    }

    async function submitOrder() {
      const selectedAddressRadio = document.querySelector('input[name="selectedAddress"]:checked');
      if (!selectedAddressRadio) {
        Swal.fire({
          icon: "warning",
          title: "Select Address",
          text: "Please select a delivery address to place your order.",
          confirmButtonColor: "#f97316"
        });
        return;
      }

      const selectedPaymentRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const paymentMethod = selectedPaymentRadio ? selectedPaymentRadio.value : "COD";

      const addressId = selectedAddressRadio.value;
      const recipientName = selectedAddressRadio.dataset.name || "";
      const recipientPhone = selectedAddressRadio.dataset.phone || "";
      const placeOrderBtn = document.getElementById("placeOrderBtn");

      function resetButton() {
        placeOrderBtn.disabled = false;
        placeOrderBtn.classList.remove("opacity-60", "cursor-not-allowed");
        placeOrderBtn.innerText = getButtonLabel(paymentMethod);
      }

      try {
        // Disable button & show loading state
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add("opacity-60", "cursor-not-allowed");
        placeOrderBtn.innerText = paymentMethod === "Razorpay" ? "Connecting to Razorpay..." : (paymentMethod === "Wallet" ? "Processing Wallet Payment..." : "Processing Order...");

        const response = await fetch("/checkout/place-order", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            addressId,
            paymentMethod,
            couponCode: appliedCouponCode
          })
        });

        const data = await response.json();

        if (!data.success) {
          Swal.fire({
            icon: "error",
            title: "Order Failed",
            text: data.message || "Failed to place order.",
            confirmButtonColor: "#f97316"
          });
          resetButton();
          return;
        }

        // 1. If COD or Wallet, redirect directly to order success
        if (paymentMethod === "COD" || paymentMethod === "Wallet") {
          window.location.href = `/checkout/order-success/${data.orderId}`;
          return;
        }

        // 2. If Razorpay, open Razorpay Checkout modal
        if (paymentMethod === "Razorpay") {
          if (typeof Razorpay === "undefined") {
            Swal.fire({
              icon: "error",
              title: "Payment SDK Unavailable",
              text: "Could not load Razorpay checkout script. Please check your internet connection or disable adblockers and try again.",
              confirmButtonColor: "#f97316"
            });
            resetButton();
            return;
          }

          const options = {
            key: data.keyId,
            amount: data.amount,
            currency: data.currency || "INR",
            name: "HeadShield",
            description: "Helmet Purchase",
            order_id: data.razorpayOrderId,
            prefill: {
              name: recipientName,
              email: LOGGED_IN_USER_EMAIL,
              contact: recipientPhone
            },
            handler: async function (razorpayResponse) {
              try {
                placeOrderBtn.innerText = "Verifying Payment...";
                const verifyRes = await fetch("/checkout/verify-payment", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json"
                  },
                  body: JSON.stringify({
                    addressId: data.addressId,
                    razorpayOrderId: razorpayResponse.razorpay_order_id,
                    razorpayPaymentId: razorpayResponse.razorpay_payment_id,
                    razorpaySignature: razorpayResponse.razorpay_signature,
                    couponCode: appliedCouponCode
                  })
                });

                const verifyData = await verifyRes.json();

                if (verifyData.success) {
                  window.location.href = `/checkout/order-success/${verifyData.orderId}`;
                } else {
                  const reason = encodeURIComponent(verifyData.message || "Payment verification failed.");
                  window.location.href = `/checkout/payment-failed?reason=${reason}`;
                }
              } catch (err) {
                console.error("Verification error:", err);
                const reason = encodeURIComponent("Payment verification could not be completed.");
                window.location.href = `/checkout/payment-failed?reason=${reason}`;
              }
            },
            modal: {
              ondismiss: function () {
                const reason = encodeURIComponent("Payment was cancelled or closed before completion.");
                window.location.href = `/checkout/payment-failed?reason=${reason}`;
              }
            },
            theme: {
              color: "#f97316"
            }
          };

          const rzp = new Razorpay(options);
          rzp.on("payment.failed", function (response) {
            const errorDesc = response.error?.description || response.error?.reason || "Payment could not be processed by your bank.";
            window.location.href = `/checkout/payment-failed?reason=${encodeURIComponent(errorDesc)}`;
          });
          rzp.open();
        }
      } catch (error) {
        console.error(error);
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Something went wrong. Please try again.",
          confirmButtonColor: "#f97316"
        });
        resetButton();
      }
    }
  </script>

  <!-- AVAILABLE COUPONS MODAL -->
  <div id="availableCouponsModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full shadow-2xl border border-gray-200 overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-bold text-gray-900">Available Coupons</h3>
          <p class="text-xs text-gray-500">Click any eligible coupon to apply to your order</p>
        </div>
        <button onclick="closeAvailableCouponsModal()" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-lg">&times;</button>
      </div>
      <div id="couponsListContainer" class="p-6 space-y-3 max-h-96 overflow-y-auto">
        <p class="text-center text-sm text-gray-400 py-6">Loading coupons...</p>
      </div>
    </div>
  </div>
</body>
</html>
