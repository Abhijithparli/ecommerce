<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Checkout - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen font-sans">

  <!-- HEADER -->
  <%- include('../partials/user/header') %>

  <div class="max-w-7xl mx-auto px-6 py-10">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-10">Checkout</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <!-- LEFT COLUMN: ADDRESS & PAYMENT -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- ADDRESS SECTION -->
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Select Delivery Address</h2>
            <a href="/profile/addresses" class="text-orange-500 hover:text-orange-600 font-semibold transition text-sm">
              + Manage Addresses
            </a>
          </div>

          <% if (addresses && addresses.length > 0) { %>
            <div class="space-y-4">
              <% addresses.forEach((addr, index) => { %>
                <label class="block cursor-pointer">
                  <input type="radio" name="selectedAddress" value="<%= addr._id %>" class="sr-only peer" <%= addr.isDefault ? 'checked' : '' %>>
                  <div class="p-5 rounded-xl border-2 border-gray-200 peer-checked:border-orange-500 peer-checked:bg-orange-50/30 hover:border-gray-300 transition duration-150 relative">
                    
                    <!-- Checked Indicator -->
                    <div class="absolute top-4 right-4 text-orange-500 hidden peer-checked:block">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>

                    <div class="flex items-center gap-3 mb-2">
                      <span class="px-2.5 py-1 bg-gray-100 text-gray-800 rounded-md text-xs font-semibold uppercase tracking-wider">
                        <%= addr.type || 'Address' %>
                      </span>
                      <% if (addr.isDefault) { %>
                        <span class="px-2.5 py-1 bg-orange-100 text-orange-800 rounded-md text-xs font-semibold">
                          Default
                        </span>
                      <% } %>
                    </div>
                    
                    <h3 class="font-bold text-gray-800 text-lg mb-1"><%= addr.name %></h3>
                    <p class="text-gray-600 leading-relaxed text-sm">
                      <%= addr.street %>, <%= addr.city %>, <%= addr.state %> - <strong class="text-gray-900"><%= addr.pincode %></strong>
                    </p>
                    <p class="text-gray-500 text-sm mt-2">
                      📞 Phone: <span class="font-medium text-gray-700"><%= addr.phone %></span>
                      <% if (addr.altphone) { %> | Alt: <%= addr.altphone %> <% } %>
                    </p>
                  </div>
                </label>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-10 bg-gray-50 rounded-xl border border-dashed border-gray-300">
              <p class="text-gray-500 mb-4">No shipping addresses found in your profile.</p>
              <a href="/profile/addresses" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-md">
                Add New Address
              </a>
            </div>
          <% } %>
        </div>

        <!-- PAYMENT METHOD SECTION -->
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200">
          <h2 class="text-2xl font-bold text-gray-800 mb-6">Payment Method</h2>
          
          <div class="space-y-4">
            
            <!-- Cash on Delivery (COD) -->
            <label class="block cursor-pointer">
              <input type="radio" name="paymentMethod" value="COD" checked class="sr-only peer">
              <div class="p-5 rounded-xl border-2 border-orange-500 bg-orange-50/30 hover:border-orange-600 transition flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="p-3 bg-orange-100 text-orange-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-800 text-lg">Cash on Delivery (COD)</h3>
                    <p class="text-gray-500 text-sm">Pay in cash when your helmet is delivered.</p>
                  </div>
                </div>
                <div class="text-orange-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
            </label>

            <!-- Razorpay (Placeholder/Disabled) -->
            <div class="p-5 rounded-xl border-2 border-gray-100 bg-gray-50/50 opacity-60 flex items-center justify-between cursor-not-allowed">
              <div class="flex items-center gap-4">
                <div class="p-3 bg-gray-200 text-gray-500 rounded-xl">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-gray-700 text-lg">Online Payment (Razorpay)</h3>
                  <p class="text-gray-400 text-sm">Coming soon in next module.</p>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY -->
      <div>
        <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-200 sticky top-28 space-y-6">
          <h2 class="text-2xl font-bold text-gray-800 pb-4 border-b border-gray-100">Order Summary</h2>

          <!-- ITEMS SUMMARY LIST -->
          <div class="max-h-60 overflow-y-auto divide-y divide-gray-100 pr-2">
            <% cart.items.forEach(item => { %>
              <div class="flex gap-4 py-4 first:pt-0 last:pb-0">
                <img src="<%= item.product.images[0] %>" class="w-16 h-16 object-cover rounded-lg border border-gray-200">
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold text-gray-800 text-sm truncate"><%= item.product.name %></h4>
                  <p class="text-gray-500 text-xs mt-1">Qty: <span class="font-semibold"><%= item.quantity %></span></p>
                </div>
                <div class="text-right">
                  <span class="font-bold text-gray-900 text-sm">₹<%= item.product.salePrice * item.quantity %></span>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- BREAKDOWN -->
          <div class="space-y-3 pt-4 border-t border-gray-100 text-sm text-gray-600">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span class="font-semibold text-gray-800">₹<%= total %></span>
            </div>
            <div class="flex justify-between">
              <span>Delivery Fee</span>
              <span class="text-green-600 font-semibold uppercase text-xs">Free</span>
            </div>
            
            <div class="flex justify-between text-lg font-bold text-gray-900 pt-3 border-t border-gray-100">
              <span>Grand Total</span>
              <span class="text-2xl text-orange-600">₹<%= total %></span>
            </div>
          </div>

          <!-- PLACE ORDER BUTTON -->
          <button id="placeOrderBtn" onclick="submitOrder()" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-2">
            Place Order (COD)
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <%- include('../partials/user/footer') %>

  <!-- JAVASCRIPT FOR SUBMITTING ORDER -->
  <script>
    async function submitOrder() {
      const selectedAddressRadio = document.querySelector('input[name="selectedAddress"]:checked');
      if (!selectedAddressRadio) {
        alert("Please select a delivery address to place your order.");
        return;
      }

      const addressId = selectedAddressRadio.value;
      const placeOrderBtn = document.getElementById("placeOrderBtn");

      try {
        // Disable button & show loading state
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add("opacity-60", "cursor-not-allowed");
        placeOrderBtn.innerText = "Processing Order...";

        const response = await fetch("/checkout/place-order", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            addressId,
            paymentMethod: "COD"
          })
        });

        const data = await response.json();

        if (data.success) {
          window.location.href = `/checkout/order-success/${data.orderId}`;
        } else {
          alert(data.message || "Failed to place order.");
          // Enable button back
          placeOrderBtn.disabled = false;
          placeOrderBtn.classList.remove("opacity-60", "cursor-not-allowed");
          placeOrderBtn.innerText = "Place Order (COD)";
        }
      } catch (error) {
        console.error(error);
        alert("Something went wrong. Please try again.");
        // Enable button back
        placeOrderBtn.disabled = false;
        placeOrderBtn.classList.remove("opacity-60", "cursor-not-allowed");
        placeOrderBtn.innerText = "Place Order (COD)";
      }
    }
  </script>
</body>
</html>
