<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Addresses - HeadShield</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500&display=swap');
  * { font-family: 'DM Sans', sans-serif; }
  h1, h2 { font-family: 'Rajdhani', sans-serif; }
</style>
</head>

<body class="bg-[#0a0a0f] text-gray-200 min-h-screen p-6 sm:p-10">

<div class="max-w-4xl mx-auto space-y-6">

  <!-- TOP NAVIGATION & HEADER -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-5 border-b border-white/10">
    <div>
      <a href="/profile" class="text-sm text-gray-400 hover:text-orange-400 transition mb-1 inline-flex items-center gap-1.5 font-medium">
        ← Back to Profile
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-wide mt-1">My Addresses</h1>
    </div>

    <button type="button" onclick="openAddressModal()"
      id="addAddressBtn"
      class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl font-semibold transition shadow-md flex items-center gap-2 text-sm">
      <span>+</span>
      <span>Add Address</span>
    </button>
  </div>

  <!-- FLASH MESSAGES -->
  <% if (success) { %>
    <div class="p-4 bg-emerald-950/40 border border-emerald-500/30 rounded-xl text-emerald-400 text-sm flex items-center gap-2">
      <span>✓</span> <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="p-4 bg-red-950/40 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-2">
      <span>⚠️</span> <span><%= error %></span>
    </div>
  <% } %>

  <!-- Add / Edit address modal -->
  <%- include("../partials/user/addressModal") %>

  <!-- ADDRESS LIST -->
  <div>
    <% if (addresses && addresses.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% addresses.forEach(addr => { %>
          <div class="bg-[#13131a] border border-white/10 hover:border-white/20 p-5 rounded-2xl flex flex-col justify-between transition duration-200">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <span class="font-bold text-white text-base truncate"><%= addr.name %></span>
                <% if (addr.isDefault) { %>
                  <span class="px-2.5 py-0.5 bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold uppercase tracking-wider rounded-full shrink-0">
                    Default
                  </span>
                <% } %>
              </div>

              <p class="text-gray-400 text-sm leading-relaxed">
                <%= addr.street %><br>
                <%= addr.city %>, <%= addr.state %> - <strong class="text-gray-200"><%= addr.pincode %></strong>
              </p>
              <p class="text-gray-400 text-xs mt-3">📞 <%= addr.phone %></p>
            </div>

            <!-- CARD ACTIONS ROW -->
            <div class="mt-5 pt-3 border-t border-white/5 flex items-center gap-4 text-sm">
              <button type="button"
                 data-address="<%= JSON.stringify({ _id: addr._id, name: addr.name, phone: addr.phone, street: addr.street, city: addr.city, state: addr.state, pincode: addr.pincode, isDefault: addr.isDefault }) %>"
                 onclick="openAddressModal(JSON.parse(this.dataset.address))"
                 class="text-yellow-400 hover:text-yellow-300 font-medium bg-transparent border-0 cursor-pointer p-0 transition">
                Edit
              </button>

              <form action="/profile/addresses/<%= addr._id %>/delete"
                    method="POST"
                    class="inline m-0 delete-addr-form"
                    onsubmit="return confirmAddressDelete(event)">
                <button type="submit" class="text-red-400 hover:text-red-300 font-medium bg-transparent border-0 cursor-pointer p-0 transition">
                  Delete
                </button>
              </form>

              <% if (!addr.isDefault) { %>
                <form action="/profile/addresses/<%= addr._id %>/default"
                      method="POST"
                      class="inline m-0 ml-auto">
                  <button type="submit" class="text-blue-400 hover:text-blue-300 font-medium bg-transparent border-0 cursor-pointer p-0 transition">
                    Set Default
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-[#13131a] border border-dashed border-white/10 rounded-2xl p-12 text-center text-gray-400">
        <div class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
          📍
        </div>
        <h3 class="text-lg font-bold text-white mb-1">No Addresses Saved</h3>
        <p class="text-sm text-gray-500 mb-5">You have not added any delivery addresses yet.</p>
        <button type="button" onclick="openAddressModal()" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition shadow">
          + Add First Address
        </button>
      </div>
    <% } %>
  </div>

</div>

<script>

// Delete Confirmation via SweetAlert2
async function confirmAddressDelete(event) {
  event.preventDefault();
  const form = event.target;

  const result = await Swal.fire({
    title: "Delete Address?",
    text: "Are you sure you want to remove this address?",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#dc2626",
    cancelButtonColor: "#4b5563",
    confirmButtonText: "Yes, Delete",
    cancelButtonText: "Cancel",
    background: "#13131a",
    color: "#ffffff"
  });

  if (result.isConfirmed) {
    form.submit();
  }
  return false;
}
</script>

</body>
</html>