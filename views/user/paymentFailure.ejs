<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Failed - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col font-sans">

  <!-- HEADER -->
  <%- include('../partials/user/header') %>

  <!-- MAIN FAILURE CARD -->
  <div class="flex-grow max-w-2xl w-full mx-auto px-6 py-12 flex items-center justify-center">
    <div class="bg-white rounded-3xl shadow-xl border border-gray-200 overflow-hidden w-full">
      
      <!-- Banner / Failure Illustration -->
      <div class="bg-gradient-to-r from-red-600 to-rose-600 py-10 text-center text-white relative px-6">
        <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-4 border border-white/30 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight">Payment Failed</h1>
        <p class="text-red-100 mt-2 text-sm sm:text-base">We couldn't process your transaction</p>
      </div>

      <!-- Content & Reason -->
      <div class="p-8 space-y-6">
        
        <!-- Error Reason Alert Box -->
        <div class="bg-red-50 border border-red-200 rounded-2xl p-4 flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <div class="text-sm">
            <h4 class="font-bold text-red-900">Reason for failure:</h4>
            <p class="text-red-700 mt-0.5"><%= reason || 'The transaction was cancelled or could not be processed by the bank.' %></p>
          </div>
        </div>

        <!-- Helpful Advice / Reassurance -->
        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-150 space-y-2 text-sm text-gray-600">
          <h4 class="font-bold text-gray-800 text-sm flex items-center gap-2">
            <span>🛡️</span> Your cart items are safe
          </h4>
          <p class="text-xs text-gray-500 leading-relaxed">
            No order was placed, and your items remain saved in your cart. If any money was deducted from your bank account, it will automatically be refunded within 5–7 business days.
          </p>
          <div class="pt-2 text-xs text-gray-500 space-y-1">
            <p>💡 <strong>What you can do next:</strong></p>
            <ul class="list-disc list-inside space-y-0.5 pl-1">
              <li>Retry using another UPI app, credit/debit card, or net banking.</li>
              <li>Or switch to <strong>Cash on Delivery (COD)</strong> at checkout.</li>
            </ul>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-3 pt-2">
          <!-- Retry Payment Button (Primary) -->
          <a href="/checkout" class="w-full flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-md hover:shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Retry Payment
          </a>

          <!-- Secondary Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/cart" class="flex-1 text-center bg-gray-900 hover:bg-gray-800 text-white font-semibold py-3 px-4 rounded-xl transition text-sm">
              View Cart
            </a>
            <a href="/products" class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-3 px-4 rounded-xl transition text-sm border border-gray-200">
              Continue Shopping
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <%- include('../partials/user/footer') %>

</body>
</html>
