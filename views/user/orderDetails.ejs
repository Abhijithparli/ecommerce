<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Details - Headshield</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500&display=swap');
  * { font-family: 'DM Sans', sans-serif; }
  h1, .brand { font-family: 'Rajdhani', sans-serif; }

  body { background: #0a0a0f; color: #e5e5e5; }

  .sidebar {
    background: linear-gradient(160deg, #111118, #0d0d14);
    border-right: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-link {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 16px; border-radius: 8px;
    color: #9ca3af; font-size: 14px;
    transition: all 0.2s; cursor: pointer; text-decoration: none;
  }
  .sidebar-link:hover, .sidebar-link.active {
    background: rgba(249,115,22,0.12);
    color: #f97316;
  }
  .sidebar-link.active { border-left: 3px solid #f97316; padding-left: 13px; }

  .card {
    background: #13131a;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
  }

  .topbar {
    background: #0d0d14;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 14px 24px;
    display: flex; align-items: center; justify-content: space-between;
  }
  
  .badge-placed { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
  .badge-shipped { background: rgba(249, 115, 22, 0.15); color: #f97316; }
  .badge-delivered { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .badge-cancelled { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .badge-returned { background: rgba(107, 114, 128, 0.15); color: #9ca3af; }
</style>
</head>
<body class="min-h-screen flex flex-col">

<!-- Top Bar -->
<div class="topbar">
  <div class="flex items-center gap-3">
    <span class="brand text-2xl font-bold text-orange-500">Headshield</span>
    <span class="text-gray-600 text-sm">/ Order Details</span>
  </div>
  <div class="flex items-center gap-4">
    <a href="/" class="text-gray-400 hover:text-white text-sm transition">← Back to Store</a>
    <form action="/logout" method="POST" class="inline m-0">
      <button class="text-sm text-red-400 hover:text-red-300 transition bg-transparent border-0 cursor-pointer">Logout</button>
    </form>
  </div>
</div>

<!-- Layout -->
<div class="flex flex-1 max-w-6xl mx-auto w-full px-4 py-8 gap-6">

  <!-- Sidebar -->
  <aside class="sidebar w-56 shrink-0 rounded-xl p-4 h-fit sticky top-8">
    <div class="text-xs text-gray-600 uppercase tracking-widest mb-3 px-2">Account</div>
    <a href="/profile" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      My Profile
    </a>
    <a href="/profile/addresses" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Addresses
    </a>
    <a href="/profile/change-password" class="sidebar-link">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      Change Password
    </a>
    <div class="border-t border-white/5 mt-3 pt-3">
      <a href="/profile/orders" class="sidebar-link active">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        My Orders
      </a>
    </div>
  </aside>

  <!-- Main -->
  <main class="flex-1 flex flex-col gap-6">
    
    <!-- BACK BUTTON -->
    <div>
      <a href="/profile/orders" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition">
        ← Back to Order History
      </a>
    </div>

    <!-- MAIN DETAIL CARD -->
    <div class="card p-8 space-y-8">
      
      <!-- HEADER INFO -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center pb-6 border-b border-white/5 gap-4">
        <div>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Order Details</span>
          <h3 class="text-xl font-bold text-white mt-1"><%= order.orderId %></h3>
          <p class="text-sm text-gray-400 mt-1">Placed on: <%= new Date(order.createdAt).toLocaleString('en-IN', {day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></p>
        </div>

              <div class="flex items-center gap-3">
          <span id="orderStatusBadge" class="px-4 py-2 text-sm font-bold rounded-lg uppercase tracking-wider badge-<%= order.status.toLowerCase() %>">
            <%= order.status %>
          </span>
          <a href="/profile/orders/<%= order._id %>/invoice" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 border border-white/10 text-white font-bold rounded-lg text-sm transition inline-block">
            Download Invoice
          </a>
          <% if (order.status === 'Placed' || order.status === 'Shipped') { %>
            <button id="cancelOrderBtn" onclick="cancelOrder('<%= order._id %>')" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg text-sm transition">
              Cancel Order
            </button>
          <% } %>
          <% if (order.status === 'Delivered') { %>
            <button id="returnOrderBtn" onclick="returnOrder('<%= order._id %>')" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-bold rounded-lg text-sm transition">
              Request Return
            </button>
          <% } %>
         </div>
     </div>

      <!-- PROGRESS TRACKER STEPPER -->
      <% if (order.status !== 'Cancelled') { %>
        <div class="py-6 pb-2 border-b border-white/5">
          <h4 class="font-bold text-white text-base mb-6">Delivery Progress</h4>
          <div class="flex items-center w-full">
            
            <!-- Placed Step -->
            <div class="flex items-center text-orange-500 relative flex-1">
              <div class="rounded-full transition duration-500 ease-in-out h-10 w-10 py-3 border-2 border-orange-500 bg-orange-500 text-white flex items-center justify-center font-bold">
                1
              </div>
              <div class="absolute top-12 left-0 text-xs font-bold text-orange-500">Placed</div>
              <div class="flex-auto border-t-2 transition duration-500 ease-in-out <%= (order.status === 'Shipped' || order.status === 'Delivered') ? 'border-orange-500' : 'border-gray-700' %>"></div>
            </div>

            <!-- Shipped Step -->
            <div class="flex items-center relative flex-1 <%= (order.status === 'Shipped' || order.status === 'Delivered') ? 'text-orange-500' : 'text-gray-500' %>">
              <div class="rounded-full transition duration-500 ease-in-out h-10 w-10 py-3 border-2 <%= (order.status === 'Shipped' || order.status === 'Delivered') ? 'border-orange-500 bg-orange-500 text-white' : 'border-gray-700 bg-transparent' %> flex items-center justify-center font-bold">
                2
              </div>
              <div class="absolute top-12 left-0 text-xs font-bold">Shipped</div>
              <div class="flex-auto border-t-2 transition duration-500 ease-in-out <%= (order.status === 'Delivered') ? 'border-orange-500' : 'border-gray-700' %>"></div>
            </div>

            <!-- Delivered Step -->
            <div class="flex items-center relative text-gray-500 <%= (order.status === 'Delivered') ? 'text-green-500' : '' %>">
              <div class="rounded-full transition duration-500 ease-in-out h-10 w-10 py-3 border-2 <%= (order.status === 'Delivered') ? 'border-green-500 bg-green-500 text-white' : 'border-gray-700 bg-transparent' %> flex items-center justify-center font-bold">
                3
              </div>
              <div class="absolute top-12 left-0 text-xs font-bold">Delivered</div>
            </div>

          </div>
        </div>
      <% } else { %>
        <div class="p-4 bg-red-950/20 border border-red-500/30 rounded-xl text-red-400 text-sm">
          ⚠️ This order has been <strong>Cancelled</strong>.
        </div>
      <% } %>

      <!-- INFO BLOCKS (SHIPPING & PAYMENT) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 py-2">
        
        <!-- Shipping Address details -->
        <div>
          <h4 class="font-bold text-white text-base mb-4">Delivery Address</h4>
          <div class="text-sm text-gray-400 space-y-1.5 bg-white/5 p-5 rounded-2xl border border-white/5">
            <span class="inline-block px-2 py-0.5 bg-white/10 text-gray-300 rounded text-[10px] font-bold uppercase tracking-wider mb-2">
              <%= order.deliveryAddress.type %>
            </span>
            <p class="font-bold text-white text-base"><%= order.deliveryAddress.name %></p>
            <p><%= order.deliveryAddress.street %></p>
            <p><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> - <%= order.deliveryAddress.pincode %></p>
            <p class="pt-2">📞 Phone: <span class="text-gray-300 font-medium"><%= order.deliveryAddress.phone %></span></p>
          </div>
        </div>

        <!-- Payment details -->
        <div>
          <h4 class="font-bold text-white text-base mb-4">Payment Information</h4>
          <div class="text-sm text-gray-400 space-y-3 bg-white/5 p-5 rounded-2xl border border-white/5 h-full">
            <div class="flex justify-between">
              <span>Method:</span>
              <strong class="text-white"><%= order.paymentMethod %></strong>
            </div>
            <div class="flex justify-between">
              <span>Status:</span>
              <span class="font-bold <%= order.paymentStatus === 'Paid' ? 'text-green-400' : 'text-yellow-400' %>">
                <%= order.paymentStatus %>
              </span>
            </div>
            <div class="pt-3 border-t border-white/5 flex justify-between items-center">
              <span>Amount Paid:</span>
              <strong class="text-xl text-orange-500 font-extrabold">₹<%= order.finalPrice %></strong>
            </div>
          </div>
        </div>

      </div>

      <!-- ORDER ITEMS LIST -->
           <div>
        <h4 class="font-bold text-white text-base mb-4">Ordered Items</h4>
        <div class="border border-white/5 rounded-2xl overflow-hidden divide-y divide-white/5 bg-white/5">
          <% order.items.forEach(item => { %>
            <div class="flex items-center gap-6 p-5">
              <img src="<%= item.image %>" class="w-16 h-16 object-cover rounded-xl border border-white/10 shrink-0">
              <div class="flex-grow min-w-0">
                <h5 class="font-bold text-white text-sm truncate"><%= item.name %></h5>
                <p class="text-xs text-gray-400 mt-1"><% if (item.size) { %>Size: <strong class="text-gray-300"><%= item.size %></strong> • <% } %>Price per unit: <strong class="text-gray-300">₹<%= item.price %></strong></p>
                <% if (item.status === 'Cancelled') { %>
                  <span class="inline-block mt-2 px-2 py-0.5 bg-red-500/10 text-red-400 text-[10px] font-bold uppercase rounded">Cancelled</span>
                <% } %>
              </div>
              <div class="text-right shrink-0">
                <p class="text-xs text-gray-400">Qty: <span class="font-bold text-white"><%= item.quantity %></span></p>
                <p class="font-bold text-orange-500 text-base mt-1">₹<%= item.price * item.quantity %></p>
                <% if (item.status !== 'Cancelled' && (order.status === 'Placed' || order.status === 'Shipped')) { %>
                  <button onclick="cancelOrderItem('<%= order._id %>', '<%= item._id %>')" class="mt-2 text-xs text-red-400 hover:text-red-300 underline bg-transparent border-0 cursor-pointer">
                    Cancel this item
                  </button>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </main>
</div>

<script>
  async function cancelOrder(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
      title: "Cancel Entire Order?",
      text: "Are you sure you want to cancel this order? This action cannot be undone.",
      input: "text",
      inputPlaceholder: "Reason for cancellation (optional)",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#dc2626",
      cancelButtonColor: "#4b5563",
      confirmButtonText: "Yes, Cancel Order",
      cancelButtonText: "Keep Order",
      background: "#13131a",
      color: "#ffffff"
    });

    if (!isConfirmed) return;

    try {
      const response = await fetch(`/profile/orders/${orderId}/cancel`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reason: reason || "" })
      });

      const data = await response.json();

      if (data.success) {
        await Swal.fire({
          icon: "success",
          title: "Order Cancelled",
          text: data.message || "Your order has been cancelled.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
        window.location.reload();
      } else {
        Swal.fire({
          icon: "error",
          title: "Cancellation Failed",
          text: data.message || "Failed to cancel order.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
      }
    } catch (error) {
      console.error("Cancel order error:", error);
      Swal.fire({
        icon: "error",
        title: "Error",
        text: "Something went wrong. Please try again.",
        confirmButtonColor: "#f97316",
        background: "#13131a",
        color: "#ffffff"
      });
    }
  }

  async function cancelOrderItem(orderId, itemId) {
    const { value: reason, isConfirmed } = await Swal.fire({
      title: "Cancel Item?",
      text: "Cancel this item from the order?",
      input: "text",
      inputPlaceholder: "Reason for cancellation (optional)",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#dc2626",
      cancelButtonColor: "#4b5563",
      confirmButtonText: "Yes, Cancel Item",
      cancelButtonText: "Keep Item",
      background: "#13131a",
      color: "#ffffff"
    });

    if (!isConfirmed) return;

    try {
      const response = await fetch(`/profile/orders/${orderId}/items/${itemId}/cancel`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reason: reason || "" })
      });

      const data = await response.json();

      if (data.success) {
        await Swal.fire({
          icon: "success",
          title: "Item Cancelled",
          text: data.message || "Item cancelled successfully.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
        window.location.reload();
      } else {
        Swal.fire({
          icon: "error",
          title: "Failed",
          text: data.message || "Failed to cancel item.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
      }
    } catch (error) {
      console.error("Cancel item error:", error);
      Swal.fire({
        icon: "error",
        title: "Error",
        text: "Something went wrong. Please try again.",
        confirmButtonColor: "#f97316",
        background: "#13131a",
        color: "#ffffff"
      });
    }
  }

  async function returnOrder(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
      title: "Request Return",
      text: "Please provide the reason for returning this delivered order:",
      input: "textarea",
      inputPlaceholder: "Explain why you are returning this item (required)",
      icon: "question",
      showCancelButton: true,
      confirmButtonColor: "#ca8a04",
      cancelButtonColor: "#4b5563",
      confirmButtonText: "Submit Return Request",
      cancelButtonText: "Cancel",
      background: "#13131a",
      color: "#ffffff",
      inputValidator: (value) => {
        if (!value || !value.trim()) {
          return "A reason is required to request a return!";
        }
      }
    });

    if (!isConfirmed || !reason) return;

    try {
      const response = await fetch(`/profile/orders/${orderId}/return`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reason: reason.trim() })
      });

      const data = await response.json();

      if (data.success) {
        await Swal.fire({
          icon: "success",
          title: "Return Requested",
          text: data.message || "Return request submitted successfully.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
        window.location.reload();
      } else {
        Swal.fire({
          icon: "error",
          title: "Request Failed",
          text: data.message || "Failed to request return.",
          confirmButtonColor: "#f97316",
          background: "#13131a",
          color: "#ffffff"
        });
      }
    } catch (error) {
      console.error("Return order error:", error);
      Swal.fire({
        icon: "error",
        title: "Error",
        text: "Something went wrong. Please try again.",
        confirmButtonColor: "#f97316",
        background: "#13131a",
        color: "#ffffff"
      });
    }
  }
</script>

</body>
</html>
