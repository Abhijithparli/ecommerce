<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Wishlist - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0a0a0f] text-gray-200 min-h-screen flex flex-col">

  <%- include("../partials/user/header", { user }) %>

  <div class="max-w-7xl mx-auto px-6 py-10 w-full flex-1">
    <h1 class="text-3xl font-bold text-white mb-8">My Wishlist</h1>

    <% if (wishlist.products && wishlist.products.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% wishlist.products.forEach(item => { %>
          <% const product = item.product; %>
          <% if (product) { %>
            <div id="wishlist-item-<%= product._id %>" class="bg-[#13131a] border border-white/5 rounded-2xl overflow-hidden flex flex-col">
              <div class="w-full h-48 bg-zinc-950 flex items-center justify-center p-4">
                <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="max-w-full max-h-full object-contain">
              </div>
              <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-white text-sm line-clamp-1"><%= product.name %></h3>
                  <p class="text-orange-500 font-bold mt-1 text-sm">₹<%= product.salePrice %></p>
                </div>
                <div class="flex gap-2">
                  <a href="/products/<%= product._id %>" class="flex-1 text-center bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold py-2.5 rounded-lg transition">
                    View Product
                  </a>
                  <button onclick="removeFromWishlist('<%= product._id %>')" class="px-3 bg-red-600/20 border border-red-500/40 text-red-400 hover:bg-red-600 hover:text-white text-xs font-semibold py-2.5 rounded-lg transition">
                    Remove
                  </button>
                </div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-[#13131a] border border-white/5 rounded-2xl p-16 text-center">
        <p class="text-gray-400 mb-6">Your wishlist is empty.</p>
        <a href="/products" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition">
          Browse Products
        </a>
      </div>
    <% } %>
  </div>

  <%- include("../partials/user/footer") %>

  <script>
    async function removeFromWishlist(productId) {
      try {
        const response = await fetch(`/wishlist/remove/${productId}`, { method: "DELETE" });
        const data = await response.json();

        if (data.success) {
          const el = document.getElementById(`wishlist-item-${productId}`);
          if (el) el.remove();
        } else {
          alert(data.message || "Failed to remove item.");
        }
      } catch (error) {
        console.error(error);
        alert("Something went wrong. Please try again.");
      }
    }
  </script>

</body>
</html>