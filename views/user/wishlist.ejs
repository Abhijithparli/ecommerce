<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Wishlist - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-[#0a0a0f] text-gray-200 min-h-screen flex flex-col">

  <%- include("../partials/user/header", { user }) %>

  <div class="max-w-7xl mx-auto px-6 py-10 w-full flex-1">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/5">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-wide">My Wishlist</h1>
        <p class="text-sm text-gray-400 mt-1">Manage and save your favorite helmets.</p>
      </div>
      <a href="/products" class="text-sm text-orange-400 hover:text-orange-300 font-semibold transition">
        Continue Shopping →
      </a>
    </div>

    <div id="wishlist-content">
      <% if (wishlist.products && wishlist.products.length > 0) { %>
        <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% wishlist.products.forEach(item => { %>
            <% const product = item.product; %>
            <% if (product) { %>
              <%
                const inStockVariants = (product.variants || []).filter(v => v.stock > 0);
                const isOutOfStock = product.quantity <= 0 || inStockVariants.length === 0;
              %>
              <div id="wishlist-item-<%= product._id %>" class="bg-[#13131a] border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-white/15 transition duration-300">
                <div>
                  <div class="relative w-full h-52 bg-zinc-950 flex items-center justify-center p-4">
                    <% if (isOutOfStock) { %>
                      <span class="absolute top-3 left-3 z-10 bg-red-600 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                        Out of Stock
                      </span>
                    <% } %>
                    <button 
                      type="button"
                      onclick="removeFromWishlist('<%= product._id %>')" 
                      class="absolute top-3 right-3 z-10 w-8 h-8 bg-black/60 hover:bg-red-600/80 rounded-full flex items-center justify-center text-gray-400 hover:text-white transition text-xs"
                      title="Remove from wishlist"
                    >
                      ✕
                    </button>
                    <a href="/products/<%= product._id %>" class="w-full h-full flex items-center justify-center">
                      <img 
                        src="<%= product.images && product.images[0] ? product.images[0] : '/img/targo-pro-biger.jpg' %>" 
                        alt="<%= product.name %>" 
                        class="max-w-full max-h-full object-contain group-hover:scale-105 transition duration-200 <%= isOutOfStock ? 'opacity-40 grayscale' : '' %>"
                      >
                    </a>
                  </div>

                  <div class="p-4 space-y-2">
                    <h3 class="font-bold text-white text-sm line-clamp-1 group-hover:text-orange-500 transition">
                      <%= product.name %>
                    </h3>
                    <div class="flex items-baseline gap-2">
                      <span class="text-orange-500 font-bold text-base">₹<%= product.salePrice || product.regularPrice %></span>
                      <% if (product.regularPrice > product.salePrice) { %>
                        <span class="text-gray-500 line-through text-xs">₹<%= product.regularPrice %></span>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="p-4 pt-0 space-y-2 border-t border-white/5">
                  <% if (!isOutOfStock) { %>
                    <div class="flex items-center gap-2 mt-3">
                      <select id="size-<%= product._id %>" aria-label="Select size" class="bg-zinc-800 border border-zinc-700 text-white text-xs rounded-lg px-2.5 py-2 focus:outline-none focus:border-orange-500">
                        <% inStockVariants.forEach(v => { %>
                          <option value="<%= v.size %>"><%= v.size %></option>
                        <% }) %>
                      </select>
                      <button 
                        type="button"
                        onclick="moveToCart('<%= product._id %>')" 
                        class="flex-1 bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold py-2 rounded-lg transition duration-200 shadow-md shadow-orange-500/10 flex items-center justify-center gap-1.5"
                      >
                        <span>🛒</span> Move to Cart
                      </button>
                    </div>
                  <% } else { %>
                    <button disabled class="w-full bg-zinc-800 border border-zinc-700 text-gray-500 text-xs font-semibold py-2 rounded-lg mt-3 cursor-not-allowed">
                      Out of Stock
                    </button>
                  <% } %>

                  <div class="flex gap-2 pt-1">
                    <a href="/products/<%= product._id %>" class="flex-1 text-center bg-zinc-800/80 hover:bg-zinc-700 text-gray-300 hover:text-white text-xs font-medium py-1.5 rounded-lg transition text-decoration-none">
                      View Details
                    </a>
                    <button 
                      type="button"
                      onclick="removeFromWishlist('<%= product._id %>')" 
                      class="px-3 bg-red-600/15 border border-red-500/30 text-red-400 hover:bg-red-600 hover:text-white text-xs font-medium py-1.5 rounded-lg transition"
                    >
                      Remove
                    </button>
                  </div>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-[#13131a] border border-white/5 rounded-2xl p-16 text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-zinc-800/80 rounded-full flex items-center justify-center text-3xl">
            ♡
          </div>
          <h2 class="text-xl font-bold text-white">Your wishlist is empty</h2>
          <p class="text-gray-400 text-sm mt-2 mb-6">Explore our catalog and save helmets you love.</p>
          <a href="/products" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-lg shadow-orange-500/20 text-decoration-none text-sm">
            Browse Helmets
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <%- include("../partials/user/footer") %>

  <script>
    // Empty wishlist HTML placeholder template
    function getEmptyWishlistHtml() {
      return `
        <div class="bg-[#13131a] border border-white/5 rounded-2xl p-16 text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-zinc-800/80 rounded-full flex items-center justify-center text-3xl">
            ♡
          </div>
          <h2 class="text-xl font-bold text-white">Your wishlist is empty</h2>
          <p class="text-gray-400 text-sm mt-2 mb-6">Explore our catalog and save helmets you love.</p>
          <a href="/products" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-lg shadow-orange-500/20 text-decoration-none text-sm">
            Browse Helmets
          </a>
        </div>
      `;
    }

    // Move to cart (adds to cart and automatically removes from wishlist)
    async function moveToCart(productId) {
      const sizeSelect = document.getElementById(`size-${productId}`);
      const size = sizeSelect ? sizeSelect.value : "M";

      try {
        const response = await fetch(`/cart/add/${productId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ quantity: 1, size: size })
        });

        const data = await response.json();

        if (data.success) {
          const card = document.getElementById(`wishlist-item-${productId}`);
          if (card) {
            card.remove();
          }

          const grid = document.getElementById("wishlist-grid");
          if (grid && grid.children.length === 0) {
            document.getElementById("wishlist-content").innerHTML = getEmptyWishlistHtml();
          }

          Swal.fire({
            icon: "success",
            title: "Moved to Cart",
            text: "Product added to cart and removed from wishlist!",
            showCancelButton: true,
            confirmButtonText: "Go to Cart",
            cancelButtonText: "Keep Shopping",
            confirmButtonColor: "#f97316",
            cancelButtonColor: "#374151"
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = "/cart";
            }
          });
        } else {
          Swal.fire({
            icon: "warning",
            title: "Could Not Move",
            text: data.message || "Failed to add to cart.",
            confirmButtonColor: "#f97316"
          });
        }
      } catch (error) {
        console.error("Move to cart error:", error);
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Something went wrong. Please try again.",
          confirmButtonColor: "#f97316"
        });
      }
    }

    // Remove item from wishlist
    async function removeFromWishlist(productId) {
      const result = await Swal.fire({
        title: "Remove Item?",
        text: "Are you sure you want to remove this item from your wishlist?",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#ef4444",
        cancelButtonColor: "#374151",
        confirmButtonText: "Yes, Remove"
      });

      if (!result.isConfirmed) return;

      try {
        const response = await fetch(`/wishlist/remove/${productId}`, { method: "DELETE" });
        const data = await response.json();

        if (data.success) {
          const el = document.getElementById(`wishlist-item-${productId}`);
          if (el) el.remove();

          const grid = document.getElementById("wishlist-grid");
          if (grid && grid.children.length === 0) {
            document.getElementById("wishlist-content").innerHTML = getEmptyWishlistHtml();
          }

          const Toast = Swal.mixin({
            toast: true,
            position: "top-end",
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
          });
          Toast.fire({
            icon: "success",
            title: "Removed from wishlist"
          });
        } else {
          Swal.fire({
            icon: "error",
            title: "Error",
            text: data.message || "Failed to remove item.",
            confirmButtonColor: "#f97316"
          });
        }
      } catch (error) {
        console.error(error);
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Something went wrong. Please try again.",
          confirmButtonColor: "#f97316"
        });
      }
    }
  </script>

</body>
</html>
