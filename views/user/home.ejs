<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Landing Page - Headshield</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        /* Header */
        header {
            background: linear-gradient(135deg, #0052CC 0%, #004DB3 100%);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logo {
            width: 50px;
            height: 50px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 12px;
            text-align: center;
            padding: 5px;
            color: #0052CC;
        }

        .header-page-title {
            color: white;
            font-size: 14px;
            font-weight: 500;
        }

        nav {
            display: flex;
            gap: 30px;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            text-transform: uppercase;
            transition: opacity 0.3s;
        }

        nav a:hover {
            opacity: 0.8;
        }

        .header-icons {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .header-icons a {
            color: white;
            font-size: 20px;
            cursor: pointer;
            text-decoration: none;
        }

        /* ===== HERO BANNER FIX ===== */
.hero-banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top; 
}

.hero-banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Optional overlay (for dark effect) */
.hero::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
        /* Main Content */
        .main-content {
            padding: 60px 40px;
            background: white;
        }

        .section-title {
            text-align: center;
            font-size: 32px;
            color: #0052CC;
            margin-bottom: 50px;
            font-weight: 700;
            font-style: italic;
        }

        /* Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .product-card {
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            text-align: center;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

 .product-image {
    width: 100%;
    height: 180px; 
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #f5f5f5;
}
.product-image img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
}

        .add-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #FF6B35;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: bold;
        }

        .product-info {
            padding: 20px;
        }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
        }

        .product-price {
            font-size: 16px;
            color: #0052CC;
            font-weight: bold;
        }

        /* Category Section */
        .category-section {
            margin-bottom: 60px;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .category-card {
            position: relative;
            height: 300px;
            border-radius: 10px;
            overflow: hidden;
            background: linear-gradient(135deg, #333, #555);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .category-name {
            color: white;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
            text-transform: uppercase;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        /* Brands Section */
        .brands-section {
            text-align: center;
            padding: 40px;
            background: linear-gradient(135deg, #f5f5f5, #efefef);
            display: flex;
            justify-content: center;
            gap: 60px;
            flex-wrap: wrap;
            margin-bottom: 60px;
        }

        .brand-logo {
            width: 120px;
            height: 60px;
            background: white;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
            color: #0052CC;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        /* Footer */
        footer {
            background: linear-gradient(135deg, #1a1a1a, #2d2d2d);
            color: white;
            padding: 40px;
            margin-top: 60px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-section h3 {
            font-size: 16px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section ul li {
            margin-bottom: 10px;
        }

        .footer-section a {
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

        .footer-section a:hover {
            color: white;
        }

        .footer-bottom {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #444;
            font-size: 14px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .social-icons a {
            color: #aaa;
            text-decoration: none;
            font-size: 16px;
            transition: color 0.3s;
        }

        .social-icons a:hover {
            color: #0052CC;
        }

        /* Responsive */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 20px;
            }

            nav {
                flex-wrap: wrap;
                justify-content: center;
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .riders-container {
                gap: 15px;
            }

            .rider {
                width: 150px;
                height: 220px;
            }

            .section-title {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <%- include("../partials/user/header") %>

   <section class="hero">
    <img src="/img/banner.png" alt="banner" class="hero-banner">
</section>


    <!-- Main Content -->
    <section class="main-content">
        <h2 class="section-title">Innovative safety for the fearless rider in you.</h2>

        <!-- Product Grid -->
        <div class="product-grid">
          <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <div class="product-card cursor-pointer" onclick="window.location.href='/products/<%= product._id %>'">
                <div class="product-image relative">
                  <img src="<%= product.images && product.images[0] ? product.images[0] : '/img/targo-pro-biger.jpg' %>" alt="<%= product.name %>">
                  <span class="absolute top-2 right-2 bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded shadow">NEW</span>
                </div>
                <div class="product-info">
                  <div class="product-name font-semibold text-gray-800 text-sm mt-2"><%= product.name %></div>
                  <div class="text-xs text-gray-500 mb-1"><%= product.brand %></div>
                  <%
                    let homeDisplayPrice = '';
                    if (product.variants && product.variants.length > 0) {
                      const prices = product.variants.map(v => v.price).filter(p => typeof p === 'number' && !isNaN(p));
                      if (prices.length > 0) {
                        const minP = Math.min(...prices);
                        const maxP = Math.max(...prices);
                        homeDisplayPrice = minP === maxP ? `₹${minP}` : `₹${minP} - ₹${maxP}`;
                      }
                    }
                    if (!homeDisplayPrice) {
                      homeDisplayPrice = `₹${product.salePrice || product.regularPrice || 0}`;
                    }
                  %>
                  <div class="flex items-center justify-center gap-2">
                    <span class="product-price text-orange-500 font-bold text-base"><%= homeDisplayPrice %></span>
                    <% if (product.regularPrice > product.salePrice) { %>
                      <span class="text-gray-400 line-through text-xs">₹<%= product.regularPrice %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="product-card">
                <div class="product-image">
                <img src="/img/targo-pro-biger.jpg" alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">MT Super Premium 4X</div>
                    <div class="product-price">USD 3,200.00</div>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
                    <img src="/img/Axor-helmets/Axor-Retro-Jet-Battle-Green-Helmet-back5.jpg " alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">Aero Ultra Shield Thunder</div>
                    <div class="product-price">USD 4,550.00</div>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
       <img src="/img/mtf3.jpg" alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">Aero Safety Air Rider</div>
                    <div class="product-price">USD 3,500.00</div>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
<img src="/img/AXOR-X-Yellow.webp"alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">AXOR 4 CROSS 12-001 MT</div>
                    <div class="product-price">USD 2,200.00</div>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
<img src="/img/axor-orange.webp"alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">Aero Retro x2 6504 XT</div>
                    <div class="product-price">USD 1,900.00</div>
                </div>
            </div>

            <div class="product-card">
                <div class="product-image">
<img src="/img/AXOR-retro.webp"alt="helmet">
                    <span class="add-badge">ADD</span>
                </div>
                <div class="product-info">
                    <div class="product-name">Aero Retro x2 Riding of Blue</div>
                    <div class="product-price">USD 1,500.00</div>
                </div>
            </div>
          <% } %>
        </div>

        <!-- Category Section -->
        <div class="category-section">
            <div class="category-grid">
              <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <div class="category-card cursor-pointer" onclick="window.location.href='/products?category=<%= cat._id %>'">
                    <% 
                      let catImg = "/img/axor1.webp";
                      if (cat.name.toUpperCase().includes("RETRO")) catImg = "/img/retrobest.webp";
                      if (cat.name.toUpperCase().includes("CROSS")) catImg = "/img/axor_X_cross_720x.webp";
                    %>
                    <img src="<%= catImg %>" alt="<%= cat.name %>" style="position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
                    <div class="category-name" style="position: relative; z-index: 2;"><%= cat.name %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="category-card">
                      <img src="/img/axor1.webp" alt="APEX" style="position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
                    <div class="category-name" style="position: relative; z-index: 2;">APEX</div>
                </div>
                <div class="category-card">
                    <img src="/img/retrobest.webp" alt="RETRO" style="position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
                    <div class="category-name" style="position: relative; z-index: 2;">RETRO</div>
                </div>
                <div class="category-card">
                  <img src="/img/axor_X_cross_720x.webp" alt="X-CROSS" style="position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
                    <div class="category-name" style="position: relative; z-index: 2;">X-CROSS</div>
                </div>
              <% } %>
            </div>
        </div>

        <!-- Brands Section -->
        <div class="brands-section">
            <div class="brand-logo">AXOR</div>
            <div class="brand-logo">MT</div>
            <div class="brand-logo">AXOR</div>
        </div>
    </section>

    <%- include("../partials/user/footer") %>
</body>
</html>
