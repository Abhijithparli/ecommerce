<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Confirmed - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col font-sans">

  <!-- HEADER -->
  <%- include('../partials/user/header') %>

  <!-- MAIN SUCCESS CARD -->
  <div class="flex-grow max-w-3xl w-full mx-auto px-6 py-12">
    <div class="bg-white rounded-3xl shadow-lg border border-gray-200 overflow-hidden">
      
      <!-- Banner / Checkmark -->
      <div class="bg-orange-500 py-12 text-center text-white relative">
        <div class="w-24 h-24 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-4 border border-white/30 animate-bounce">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight">Thank You For Your Order!</h1>
        <p class="text-orange-100 mt-2 text-lg">Your helmet is secured and on its way.</p>
      </div>

      <!-- Order Details Summary -->
      <div class="p-8 space-y-6">
        
        <!-- ID & Status -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-6 border-b border-gray-100 gap-4">
          <div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Order Identifier</span>
            <h3 class="text-lg font-bold text-gray-800"><%= order.orderId %></h3>
          </div>
          <div class="flex gap-3">
            <span class="px-4 py-2 bg-orange-100 text-orange-800 font-bold rounded-lg text-sm">
              <%= order.status %>
            </span>
            <span class="px-4 py-2 bg-gray-100 text-gray-600 font-bold rounded-lg text-sm">
              <%= order.paymentMethod %>
            </span>
          </div>
        </div>

        <!-- Address & Pricing -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 py-2">
          
          <!-- Shipping Address info -->
          <div>
            <h4 class="font-bold text-gray-800 text-base mb-3">Shipping Address</h4>
            <div class="text-sm text-gray-600 space-y-1">
              <p class="font-semibold text-gray-800"><%= order.deliveryAddress.name %></p>
              <p><%= order.deliveryAddress.street %></p>
              <p><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> - <%= order.deliveryAddress.pincode %></p>
              <p class="pt-2 text-gray-500">📞 Phone: <%= order.deliveryAddress.phone %></p>
            </div>
          </div>

          <!-- Price Summary info -->
          <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 space-y-3 h-fit">
            <h4 class="font-bold text-gray-800 text-base mb-2">Order Price</h4>
            <div class="flex justify-between text-sm text-gray-600">
              <span>Items Total</span>
              <span>₹<%= order.totalPrice %></span>
            </div>
            <% if (order.discount > 0) { %>
              <div class="flex justify-between text-sm text-red-600">
                <span>Coupon Discount</span>
                <span>- ₹<%= order.discount %></span>
              </div>
            <% } %>
            <div class="flex justify-between text-sm text-gray-600 pb-2 border-b border-gray-200">
              <span>Delivery Charges</span>
              <span class="text-green-600 font-semibold uppercase">Free</span>
            </div>
            <div class="flex justify-between text-lg font-extrabold text-gray-900 pt-1">
              <span>Grand Total</span>
              <span class="text-xl text-orange-600">₹<%= order.finalPrice %></span>
            </div>
          </div>

        </div>

        <!-- Buttons navigation -->
        <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-gray-100">
          <a href="/profile/orders" class="flex-1 text-center bg-gray-950 hover:bg-gray-900 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-md">
            View My Orders
          </a>
          <a href="/products" class="flex-1 text-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-md">
            Continue Shopping
          </a>
        </div>

      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <%- include('../partials/user/footer') %>

</body>
</html>
