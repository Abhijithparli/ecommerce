<% const currentUser = (typeof user !== 'undefined' && user) ? user : null; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Styling for dynamic mouse pan/zoom container */
    .zoom-container {
      position: relative;
      overflow: hidden;
      cursor: zoom-in;
    }
    .zoom-image {
      transition: transform 0.1s ease-out;
      transform-origin: center center;
    }
    /* Tab buttons active states */
    .tab-btn.active {
      border-bottom: 3px solid #f97316; /* bg-orange-500 */
      color: #f97316;
      font-weight: bold;
    }
  </style>
</head>
<body class="bg-[#0a0a0f] text-gray-200 min-h-screen flex flex-col">

  <!-- Include Header -->
  <%- include("../partials/user/header", { user: currentUser }) %>

  <!-- Main Details Section -->
  <div class="max-w-7xl mx-auto px-6 py-10 w-full flex-1 flex flex-col gap-12">
    
    <!-- BREADCRUMBS -->
    <div class="text-xs text-gray-500 flex items-center gap-2 uppercase tracking-wider">
      <a href="/" class="hover:text-orange-500 transition text-decoration-none text-gray-400">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-orange-500 transition text-decoration-none text-gray-400">Products</a>
      <span>/</span>
      <span class="text-gray-300 font-medium"><%= product.name %></span>
    </div>

    <!-- Product Split Screen -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 bg-[#13131a] border border-white/5 rounded-2xl p-8 shadow-2xl">
      
      <!-- Left: Interactive Gallery -->
      <div class="space-y-6">
        <!-- Main Image Container with zoom -->
        <div class="zoom-container w-full h-[450px] bg-zinc-950 rounded-2xl border border-white/5 flex items-center justify-center p-6" id="zoomContainer">
          <img 
            id="mainImage" 
            src="<%= product.images[0] %>" 
            alt="<%= product.name %>" 
            class="zoom-image max-w-full max-h-full object-contain"
          >
        </div>

        <!-- Thumbnails -->
        <div class="flex items-center gap-4 overflow-x-auto py-2">
          <% product.images.forEach((img, idx) => { %>
            <div 
              class="w-20 h-20 bg-zinc-950 rounded-xl border border-white/5 hover:border-orange-500 transition duration-200 cursor-pointer overflow-hidden p-2 flex items-center justify-center shrink-0"
              onclick="document.getElementById('mainImage').src = '<%= img %>'"
            >
              <img src="<%= img %>" alt="Thumbnail" class="max-w-full max-h-full object-contain">
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Right: Purchase Panel Details -->
      <div class="flex flex-col justify-between space-y-6">
        
        <div class="space-y-4">
          <!-- Brand and Title -->
          <div class="space-y-1">
            <span class="bg-orange-500/10 text-orange-400 border border-orange-500/20 text-[10px] font-bold tracking-wider px-2.5 py-1 rounded uppercase">
              <%= product.brand %>
            </span>
            <h1 class="text-3xl font-extrabold text-white tracking-wide mt-2">
              <%= product.name %>
            </h1>
            <p class="text-sm text-gray-500">Category: <span class="text-gray-300 font-medium"><%= product.category?.name %></span></p>
          </div>

          <!-- Ratings Summary -->
          <div class="flex items-center gap-3 border-y border-white/5 py-3 text-sm">
            <div class="flex text-emerald-400 text-base">
              <% for(let i = 1; i <= 5; i++) { %>
                <%= i <= Math.round(averageRating) ? '★' : '☆' %>
              <% } %>
            </div>
            <span class="text-gray-300 font-bold">(<%= averageRating.toFixed(1) %>)</span>
            <span class="text-gray-600">•</span>
            <span class="text-gray-400"><%= reviews.length %> Verified Reviews</span>
            <span class="text-gray-600">•</span>
            <% if (product.quantity > 0) { %>
              <span class="text-emerald-400 font-semibold uppercase tracking-wider text-xs">In Stock</span>
            <% } else { %>
              <span class="text-red-400 font-semibold uppercase tracking-wider text-xs">Out Of Stock</span>
            <% } %>
          </div>

          <!-- Pricing & Discounts -->
          <div class="space-y-2">
            <div class="flex items-baseline gap-4">
              <!-- Sale Price -->
              <span class="text-3xl font-extrabold text-orange-500">₹<%= product.salePrice %></span>
              <!-- Slashed regular price -->
              <% if (product.regularPrice > product.salePrice) { %>
                <span class="text-xl text-gray-500 line-through">₹<%= product.regularPrice %></span>
                <span class="bg-red-500/10 border border-red-500/20 text-red-400 px-3 py-1 rounded-full text-xs font-bold font-mono">
                  <%= Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100) %>% OFF
                </span>
              <% } %>
            </div>
            <p class="text-xs text-gray-500">Prices are inclusive of all local taxes.</p>
          </div>
        </div>

        <!-- Variants, Quantity & Cart Controls -->
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row gap-6">
            
            <!-- Size Select (Figma) -->
            <div class="flex-1 space-y-2">
              <label class="block text-xs text-gray-500 uppercase tracking-widest font-semibold">Select Size</label>
              <select id="sizeSelector" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-orange-500 transition duration-200">
                <% if (product.variants && product.variants.length > 0) { %>
                  <% product.variants.forEach(variant => { %>
                    <option value="<%= variant.size %>"><%= variant.size %> (Qty: <%= variant.quantity %>)</option>
                  <% }) %>
                <% } else { %>
                  <option value="M">Medium (M)</option>
                  <option value="L">Large (L)</option>
                  <option value="XL">Extra Large (XL)</option>
                <% } %>
              </select>
            </div>

            <!-- Quantity Selector (Figma) -->
            <div class="w-full sm:w-36 space-y-2">
              <label class="block text-xs text-gray-500 uppercase tracking-widest font-semibold font-mono">Quantity</label>
              <div class="flex items-center border border-zinc-700 rounded-xl overflow-hidden bg-zinc-800 h-[46px]">
                <button type="button" onclick="adjustQty(-1)" class="w-12 text-white hover:bg-zinc-700 font-bold h-full transition">-</button>
                <input type="text" id="qtyInput" value="1" readonly class="w-12 bg-transparent text-center text-sm font-semibold text-white focus:outline-none h-full">
                <button type="button" onclick="adjustQty(1)" class="w-12 text-white hover:bg-zinc-700 font-bold h-full transition">+</button>
              </div>
            </div>

          </div>

          <!-- Purchase buttons (Figma) & Wishlist heart -->
          <div class="flex items-center gap-4">
            
            <% if (product.quantity > 0) { %>
              <!-- Add to Cart (orange) -->
              <button 
                onclick="addToCart('<%= product._id %>', false)" 
                class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-bold py-3.5 rounded-xl transition duration-200 shadow-lg"
              >
                Add To Cart
              </button>
              
              <!-- Buy Now (red) -->
              <button 
                onclick="buyNow('<%= product._id %>')" 
                class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3.5 rounded-xl transition duration-200 shadow-lg"
              >
                Buy Now
              </button>
            <% } else { %>
              <button 
                disabled 
                class="flex-1 bg-zinc-800 border border-zinc-700 text-gray-600 font-bold py-3.5 rounded-xl cursor-not-allowed text-center"
              >
                Out of Stock
              </button>
            <% } %>

            <!-- Save button (Figma Wishlist Heart) -->
            <button 
              onclick="handleGuestAction(event, 'wishlist')" 
              class="w-[50px] h-[50px] bg-zinc-800 hover:bg-zinc-700 text-gray-300 hover:text-red-500 border border-zinc-700 rounded-xl flex items-center justify-center text-2xl transition duration-200 shadow"
              title="Add to Wishlist"
            >
              ♡
            </button>

          </div>
        </div>

        <!-- Delivery Badges Section (Figma) -->
        <div class="grid grid-cols-2 gap-4 border-t border-white/5 pt-6 text-sm">
          <div class="flex items-start gap-3 bg-zinc-800/30 border border-white/5 rounded-xl p-3">
            <span class="text-2xl text-emerald-400 mt-1">🚚</span>
            <div>
              <p class="font-bold text-white text-xs uppercase tracking-wider">Free Delivery</p>
              <p class="text-[11px] text-gray-500 mt-1">Enter your pin code to check availability.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 bg-zinc-800/30 border border-white/5 rounded-xl p-3">
            <span class="text-2xl text-emerald-400 mt-1">🔄</span>
            <div>
              <p class="font-bold text-white text-xs uppercase tracking-wider">Return policy</p>
              <p class="text-[11px] text-gray-500 mt-1">Free 30 days returns & exchanges.</p>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Description, Reviews & Highlights Dynamic Tabs -->
    <div class="bg-[#13131a] border border-white/5 rounded-2xl p-8 space-y-6">
      
      <!-- Tab Headers -->
      <div class="flex items-center gap-8 border-b border-white/5 pb-4">
        <button onclick="switchTab('description')" id="tabBtn-description" class="tab-btn active text-sm uppercase tracking-widest font-semibold pb-2 text-gray-400 hover:text-white transition">
          Description
        </button>
        <button onclick="switchTab('reviews')" id="tabBtn-reviews" class="tab-btn text-sm uppercase tracking-widest font-semibold pb-2 text-gray-400 hover:text-white transition">
          Reviews (<%= reviews.length %>)
        </button>
      </div>

      <!-- Tab 1: Description & Manufacturer Highlights -->
      <div id="tabPanel-description" class="tab-panel space-y-8">
        
        <!-- Text -->
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-white">Product Overview</h2>
          <p class="text-gray-400 leading-relaxed text-sm">
            <%= product.description %>
          </p>
        </div>

        <!-- Product Highlights dynamic loop (Figma) -->
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-white">Product Highlights</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-disc pl-5 text-gray-400 text-sm">
            <% if (product.highlights && product.highlights.length > 0) { %>
              <% product.highlights.forEach(highlight => { %>
                <li class="leading-relaxed"><%= highlight %></li>
              <% }) %>
            <% } else { %>
              <li>Premium aerodynamic design.</li>
              <li>Breathable, fully removable inner lining.</li>
              <li>High-durability ABS thermoplastic shell.</li>
              <li>DOT and ECE certified protection structure.</li>
              <li>Scratch-resistant visor layout.</li>
            <% } %>
          </ul>
        </div>

        <!-- Manufacturer specifications panels (Figma illustration references) -->
        <div class="space-y-6 border-t border-white/5 pt-8">
          <h2 class="text-xl font-bold text-white text-center">Engineered for Superior Security</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-zinc-900 border border-white/5 rounded-xl p-6 space-y-3">
              <span class="text-3xl text-orange-500 font-bold">🌪</span>
              <h3 class="font-bold text-white text-base">Ventilation System</h3>
              <p class="text-xs text-gray-500 leading-relaxed">
                Mouth vents and top channels flow cool air directly to the rider's face, reducing fogging and keeping the inner padding dry.
              </p>
            </div>
            
            <div class="bg-zinc-900 border border-white/5 rounded-xl p-6 space-y-3">
              <span class="text-3xl text-orange-500 font-bold">👓</span>
              <h3 class="font-bold text-white text-base">Panoramic Vision</h3>
              <p class="text-xs text-gray-500 leading-relaxed">
                Scratch-resistant and UV-resistant panoramic visors ensure crystal clear views, compatible with Pinlock inserts.
              </p>
            </div>

            <div class="bg-zinc-900 border border-white/5 rounded-xl p-6 space-y-3">
              <span class="text-3xl text-orange-500 font-bold">🛡</span>
              <h3 class="font-bold text-white text-base">Double EPS Core</h3>
              <p class="text-xs text-gray-500 leading-relaxed">
                Dual density EPS liners cushion impacts and absorb kinetic energy, secured with micro-metric chin straps.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Tab 2: Reviews -->
      <div id="tabPanel-reviews" class="tab-panel hidden space-y-8">
        
        <!-- Review submission -->
        <div class="bg-zinc-900 border border-white/5 rounded-xl p-6">
          <h3 class="text-lg font-bold text-white mb-4">Write a Review</h3>
          <form action="/products/<%= product._id %>/review" method="POST" class="space-y-4">
            <div>
              <label class="block text-xs text-gray-500 uppercase font-semibold mb-2">Rating</label>
              <select name="rating" required class="bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 text-sm text-white focus:outline-none focus:border-orange-500 transition">
                <option value="">Select Stars</option>
                <option value="5">★★★★★ Excellent</option>
                <option value="4">★★★★☆ Very Good</option>
                <option value="3">★★★☆☆ Good</option>
                <option value="2">★★☆☆☆ Average</option>
                <option value="1">★☆☆☆☆ Poor</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-gray-500 uppercase font-semibold mb-2">Review Comment</label>
              <textarea name="comment" rows="4" placeholder="Share your experience with this helmet..." required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition"></textarea>
            </div>
            <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm px-6 py-2.5 rounded-lg transition duration-200">
              Submit Review
            </button>
          </form>
        </div>

        <!-- Reviews list -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-white border-b border-white/5 pb-2">Customer Feedback</h3>
          <% if (reviews.length > 0) { %>
            <div class="space-y-4">
              <% reviews.forEach(review => { %>
                <div class="bg-zinc-900/40 border border-white/5 rounded-xl p-5 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-white text-sm">
                      <%= review.user ? review.user.name : 'Verified Customer' %>
                    </span>
                    <div class="text-emerald-400 text-xs">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <%= i <= review.rating ? '★' : '☆' %>
                      <% } %>
                    </div>
                  </div>
                  <p class="text-sm text-gray-400 leading-relaxed">
                    <%= review.comment %>
                  </p>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-sm text-gray-500 text-center py-8">No reviews yet. Be the first to share your opinion!</p>
          <% } %>
        </div>

      </div>

    </div>

    <!-- Related Products Showcase -->
    <div class="space-y-6 mt-6">
      <h2 class="text-2xl font-bold text-white tracking-wide border-b border-white/5 pb-3">Related Products</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% relatedProducts.forEach(item => { %>
          <div class="bg-[#13131a] border border-white/5 rounded-2xl overflow-hidden hover:scale-[1.02] transition duration-300 flex flex-col group">
            <div class="w-full h-48 bg-zinc-950 flex items-center justify-center p-4">
              <img src="<%= item.images[0] %>" alt="<%= item.name %>" class="max-w-full max-h-full object-contain">
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <h3 class="font-bold text-white text-sm group-hover:text-orange-500 transition duration-200 line-clamp-1">
                  <%= item.name %>
                </h3>
                <p class="text-orange-500 font-bold mt-1 text-sm">₹<%= item.salePrice %></p>
              </div>
              <a href="/products/<%= item._id %>" class="block text-center bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold py-2.5 rounded-lg transition text-decoration-none">
                View Product
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  </div>

  <!-- Include Footer -->
  <%- include("../partials/user/footer") %>

  <!-- Javascript functionalities (Quantity count, tab toggles, mouse-move zoom) -->
  <script>
    // Quantity control handler
    function adjustQty(amount) {
      const input = document.getElementById("qtyInput");
      let currentVal = parseInt(input.value);
      if (isNaN(currentVal)) currentVal = 1;
      
      currentVal += amount;
      if (currentVal < 1) currentVal = 1;
      
      input.value = currentVal;
    }

    // Switch Details tab
    function switchTab(tabId) {
      document.querySelectorAll(".tab-panel").forEach(p => p.classList.add("hidden"));
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      
      document.getElementById(`tabPanel-${tabId}`).classList.remove("hidden");
      document.getElementById(`tabBtn-${tabId}`).classList.add("active");
    }

    // Interactive mouse zoom
    const zoomContainer = document.getElementById("zoomContainer");
    const mainImage = document.getElementById("mainImage");

    zoomContainer.addEventListener("mousemove", (e) => {
      const rect = zoomContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const xPercent = (x / rect.width) * 100;
      const yPercent = (y / rect.height) * 100;

      mainImage.style.transformOrigin = `${xPercent}% ${yPercent}%`;
      mainImage.style.transform = "scale(2)";
    });

    zoomContainer.addEventListener("mouseleave", () => {
      mainImage.style.transform = "scale(1)";
      mainImage.style.transformOrigin = "center center";
    });

    // AJAX cart submission and guest checks
    async function addToCart(productId, redirect = false) {
      if (!window.isLoggedIn) {
        alert("Please login to continue");
        window.location.href = "/login";
        return;
      }
      
      try {
        const qty = parseInt(document.getElementById("qtyInput").value) || 1;
        const response = await fetch(`/cart/add/${productId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ quantity: qty })
        });
        
        const data = await response.json();
        if (data.success) {
          if (redirect) {
            window.location.href = "/cart";
          } else {
            alert(data.message);
          }
        } else {
          alert(data.message || "Failed to add to cart");
        }
      } catch (error) {
        console.error("Cart error:", error);
        alert("Something went wrong");
      }
    }

    // Buy Now redirection
    function buyNow(productId) {
      addToCart(productId, true);
    }
  </script>

</body>
</html>