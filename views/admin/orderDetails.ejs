<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Order Details - HeadShield</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

<div class="flex w-full">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "orders"
  }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-8">
    <div class="max-w-4xl w-full mx-auto">
      
      <!-- Back Link -->
      <a href="/admin/orders" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 transition mb-6">
        ← Back to Order Management
      </a>

      <!-- FLASH NOTIFICATIONS -->
      <% if (success) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
          <%= success %>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
          <%= error %>
        </div>
      <% } %>

      <!-- MAIN CARD -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        
        <!-- Header Info -->
        <div class="p-8 border-b border-gray-150 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Order Details</span>
            <h1 class="text-2xl font-bold text-gray-900 mt-1"><%= order.orderId %></h1>
            <p class="text-xs text-gray-500 mt-1">Placed on: <%= new Date(order.createdAt).toLocaleString('en-IN', {day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></p>
          </div>
          
          <!-- Status Change Panel -->
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 w-full md:w-auto">
            <form action="/admin/orders/<%= order._id %>/status" method="POST" class="flex flex-col sm:flex-row gap-3 items-end sm:items-center">
              <div>
                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Order Status</label>
                <% if (order.status === 'Cancelled' || order.status === 'Delivered') { %>
                  <span class="inline-block px-4 py-2 bg-gray-200 text-gray-700 font-bold rounded-lg text-sm uppercase tracking-wider">
                    <%= order.status %>
                  </span>
                <% } else { %>
                  <select name="status" class="px-3 py-2 rounded-lg bg-white border border-gray-300 text-sm font-semibold text-gray-700 focus:outline-none focus:ring-2 focus:ring-orange-500">
                    <option value="Placed" <%= order.status === 'Placed' ? 'selected' : '' %>>Placed</option>
                    <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                <% } %>
              </div>
              
              <% if (order.status !== 'Cancelled' && order.status !== 'Delivered') { %>
                <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition shadow-sm w-full sm:w-auto">
                  Update
                </button>
              <% } %>
            </form>
          </div>
        </div>

        <div class="p-8 space-y-8">
          
          <!-- CUSTOMER & DELIVERY INFO -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Customer info -->
            <div>
              <h3 class="font-bold text-gray-800 text-base mb-3 border-b border-gray-100 pb-2">Customer Details</h3>
              <div class="text-sm text-gray-600 space-y-1.5">
                <p>👤 Name: <strong class="text-gray-850"><%= order.user ? order.user.name : 'Unknown User' %></strong></p>
                <p>📧 Email: <span class="font-medium"><%= order.user ? order.user.email : 'No Email' %></span></p>
              </div>
            </div>

            <!-- Delivery address -->
            <div>
              <h3 class="font-bold text-gray-800 text-base mb-3 border-b border-gray-100 pb-2">Delivery Address</h3>
              <div class="text-sm text-gray-600 space-y-1 bg-gray-50 p-4 rounded-xl border border-gray-150">
                <span class="inline-block px-2 py-0.5 bg-gray-200 text-gray-600 rounded text-[9px] font-bold uppercase tracking-wider mb-2">
                  <%= order.deliveryAddress.type %>
                </span>
                <p class="font-bold text-gray-850"><%= order.deliveryAddress.name %></p>
                <p><%= order.deliveryAddress.street %></p>
                <p><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> - <%= order.deliveryAddress.pincode %></p>
                <p class="pt-2 text-gray-500">📞 Phone: <%= order.deliveryAddress.phone %></p>
              </div>
            </div>

          </div>

          <!-- PAYMENT & PRICING -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Payment info -->
            <div>
              <h3 class="font-bold text-gray-800 text-base mb-3 border-b border-gray-100 pb-2">Payment Details</h3>
              <div class="text-sm text-gray-600 space-y-2">
                <p>Method: <strong class="text-gray-800"><%= order.paymentMethod %></strong></p>
                <p>Status: <span class="font-bold <%= order.paymentStatus === 'Paid' ? 'text-green-600' : 'text-yellow-600' %>"><%= order.paymentStatus %></span></p>
              </div>
            </div>

            <!-- Pricing calculation -->
            <div class="bg-gray-50 p-5 rounded-xl border border-gray-150 space-y-3">
              <h3 class="font-bold text-gray-800 text-base mb-2 border-b border-gray-200 pb-2">Total Summary</h3>
              <div class="flex justify-between text-sm text-gray-600">
                <span>Items Subtotal</span>
                <span>₹<%= order.totalPrice %></span>
              </div>
              <% if (order.discount > 0) { %>
                <div class="flex justify-between text-sm text-red-600">
                  <span>Coupon Discount</span>
                  <span>- ₹<%= order.discount %></span>
                </div>
              <% } %>
              <div class="flex justify-between text-sm text-gray-600 pb-2 border-b border-gray-200">
                <span>Delivery Charge</span>
                <span class="text-green-600 font-semibold uppercase text-xs">Free</span>
              </div>
              <div class="flex justify-between text-base font-extrabold text-gray-900 pt-1">
                <span>Grand Total</span>
                <span class="text-lg text-orange-600">₹<%= order.finalPrice %></span>
              </div>
            </div>

          </div>

          <!-- ORDERED ITEMS LIST -->
          <div>
            <h3 class="font-bold text-gray-800 text-base mb-3 border-b border-gray-100 pb-2">Ordered Items</h3>
            <div class="border border-gray-200 rounded-xl overflow-hidden divide-y divide-gray-200 bg-white">
              <% order.items.forEach(item => { %>
                <div class="flex items-center gap-6 p-4">
                  <img src="<%= item.image %>" class="w-14 h-14 object-cover rounded-lg border border-gray-100 shrink-0">
                  <div class="flex-grow min-w-0">
                    <h5 class="font-bold text-gray-800 text-sm truncate"><%= item.name %></h5>
                    <p class="text-xs text-gray-500 mt-1"><% if (item.size) { %>Size: <strong class="text-gray-700"><%= item.size %></strong> • <% } %>Unit Price: <strong>₹<%= item.price %></strong></p>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="text-xs text-gray-500">Qty: <span class="font-bold text-gray-800"><%= item.quantity %></span></p>
                    <p class="font-bold text-orange-500 text-sm mt-1">₹<%= item.price * item.quantity %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>

</div>

</body>
</html>
