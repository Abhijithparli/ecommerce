<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Category Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Custom Bootstrap pagination styling for dark theme container */
    .pagination {
      display: flex;
      padding-left: 0;
      list-style: none;
    }
    .page-item {
      margin: 0 2px;
    }
    .page-link {
      position: relative;
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: #cbd5e1; /* text-gray-300 */
      background-color: #374151; /* bg-gray-700 */
      border: 1px solid #4b5563; /* border-gray-600 */
      border-radius: 0.375rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .page-link:hover {
      color: #ffffff;
      background-color: #4b5563; /* bg-gray-600 */
      border-color: #6b7280;
    }
    .page-item.active .page-link {
      color: #ffffff;
      background-color: #f97316; /* bg-orange-500 */
      border-color: #f97316;
    }
    .page-item.disabled .page-link {
      color: #9ca3af; /* text-gray-400 */
      pointer-events: none;
      background-color: #1f2937; /* bg-gray-900 */
      border-color: #374151;
      opacity: 0.5;
    }
  </style>
</head>

<body <body class="bg-gray-100 min-h-screen">

<div class="flex w-full">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "categories"
  }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-6">

<div class="w-full">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">
      Category Management <span class="text-lg font-normal text-gray-500">(Total: <%= totalCategories %>)</span>
    </h1>
    <a
      href="/admin/categories/add"
      class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition"
    >
      Add Category
    </a>
  </div>
  <!-- SEARCH BAR -->
<div class="bg-gray-800 rounded-xl p-5 mb-6">

  <form
    action="/admin/categories"
    method="GET"
    class="flex gap-3"
  >

    <input
      type="text"
      name="search"
      value="<%= search %>"
      placeholder="Search category..."
      class="flex-1 px-4 py-3 rounded-lg bg-gray-700 border border-gray-600 text-white placeholder-gray-300 focus:outline-none"
    >

    <!-- SEARCH BUTTON -->
    <button
      class="bg-orange-500 hover:bg-orange-600 px-5 rounded-lg"
    >
      Search
    </button>

    <!-- CLEAR BUTTON -->
    <a
      href="/admin/categories"
      class="bg-gray-600 hover:bg-gray-500 px-5 py-3 rounded-lg"
    >
      Clear
    </a>

  </form>

</div>


  <!-- SUCCESS MESSAGE -->
  <% if (success) { %>
    <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-3 rounded mb-4">
      <%= success %>
    </div>
  <% } %>

  <!-- ERROR MESSAGE -->
  <% if (error) { %>
    <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  </div>


  <!-- CATEGORY TABLE -->
  <div class="bg-gray-800 rounded-xl shadow-lg overflow-hidden">

    <table class="w-full">

      <!-- TABLE HEAD -->
      <thead class="bg-gray-700 text-left text-white">
        <tr>
          <th class="px-6 py-4">Category</th>
          <th class="px-6 py-4">Description</th>
          <th class="px-6 py-4">Created</th>
          <th class="px-6 py-4 text-center">Actions</th>
        </tr>
      </thead>

      <!-- TABLE BODY -->
      <tbody>

      <% if (categories.length > 0) { %>

        <% categories.forEach(category => { %>

         <tr class="border-t border-gray-700 hover:bg-gray-700/40 text-white">

            <!-- NAME -->
           <td class="px-6 py-4 font-medium text-white">
              <%= category.name %>
            </td>

            <!-- DESCRIPTION -->
            <td class="px-6 py-4 text-gray-300">
              <%= category.description || "No description" %>
            </td>

            <!-- DATE -->
            <td class="px-6 py-4 text-sm text-gray-400">
              <%= category.createdAt.toDateString() %>
            </td>

            <!-- ACTIONS -->
            <td class="px-6 py-4">

              <div class="flex justify-center gap-3">

                <!-- EDIT FORM -->
<a
  href="/admin/categories/<%= category._id %>/edit"
  class="bg-yellow-500 hover:bg-yellow-600 px-3 py-1 rounded"
>
  Edit
</a>

                <!-- DELETE -->
<form
  action="/admin/categories/<%= category._id %>/delete"
  method="POST"
  class="deleteForm"
>

  <button
    type="button"
    onclick="openDeleteModal(this)"
    class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded"
  >
    Delete
  </button>

</form>

              </div>

            </td>

          </tr>

        <% }) %>

      <% } else { %>

        <tr>
          <td colspan="4" class="text-center py-8 text-gray-400">
            No categories found
          </td>
        </tr>

      <% } %>

      </tbody>

    </table>
    <!-- PAGINATION -->
    <% if (totalPages > 1) { %>
    <div class="flex justify-center items-center py-6">
      <nav aria-label="Page navigation">
        <ul class="pagination">
          <!-- PREVIOUS -->
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a
              class="page-link"
              href="/admin/categories?page=<%= currentPage - 1 %>&search=<%= search %>"
            >
              Previous
            </a>
          </li>

          <!-- PAGE NUMBERS -->
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a
                class="page-link"
                href="/admin/categories?page=<%= i %>&search=<%= search %>"
              >
                <%= i %>
              </a>
            </li>
          <% } %>

          <!-- NEXT -->
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a
              class="page-link"
              href="/admin/categories?page=<%= currentPage + 1 %>&search=<%= search %>"
            >
              Next
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <% } %>

  </div>

</div>

<!-- DELETE MODAL -->
<div
  id="deleteModal"
  class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50"
>

  <div class="bg-gray-800 w-full max-w-md rounded-2xl p-6 shadow-2xl">

    <h2 class="text-xl font-bold mb-3 text-white">
      Delete Category
    </h2>

    <p class="text-gray-300 mb-6">
      Are you sure you want to delete this category?
    </p>

    <div class="flex justify-end gap-3">

      <button
        onclick="closeDeleteModal()"
        class="px-5 py-2 rounded bg-gray-600 hover:bg-gray-500"
      >
        Cancel
      </button>

      <button
        id="confirmDeleteBtn"
        class="px-5 py-2 rounded bg-red-500 hover:bg-red-600"
      >
        Delete
      </button>

    </div>

  </div>

</div>
<script>

let selectedForm = null;

function openDeleteModal(button) {

  selectedForm = button.closest("form");

  const modal = document.getElementById("deleteModal");

  modal.classList.remove("hidden");
  modal.classList.add("flex");
}

function closeDeleteModal() {

  const modal = document.getElementById("deleteModal");

  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

document
  .getElementById("confirmDeleteBtn")
  .addEventListener("click", function () {

    if (selectedForm) {
      selectedForm.submit();
    }
  });

</script>
</body>
</html>