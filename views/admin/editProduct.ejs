<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Product</title>

  <!-- TAILWIND -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"
  />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
</head>

<body class="bg-gray-100 text-gray-900 min-h-screen">
<div class="flex w-full min-h-screen bg-gray-100 text-gray-900">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "products"
  }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-6">
    <h1 class="text-3xl font-bold mb-8">Edit Product</h1>

    <!-- EDIT PRODUCT FORM -->
    <div class="bg-white rounded-2xl p-8 mb-10 shadow-lg border border-gray-200">
      <h2 class="text-2xl font-semibold mb-6">Modify Product Details</h2>

      <% if (error) { %>
        <div class="bg-red-500/20 border border-red-500 text-red-700 px-4 py-3 rounded mb-6">
          <%= error %>
        </div>
      <% } %>

      <form
        action="/admin/products/<%= product._id %>/edit"
        method="POST"
        enctype="multipart/form-data"
        class="grid grid-cols-1 md:grid-cols-2 gap-6"
        novalidate
      >
        <!-- ROW 1: PRODUCT NAME | BRAND -->
        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Product Name</label>
          <input
            type="text"
            name="name"
            value="<%= product.name %>"
            placeholder="Enter product name"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Brand</label>
          <input
            type="text"
            name="brand"
            value="<%= product.brand %>"
            placeholder="Enter brand"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <!-- ROW 2: CATEGORY | SIZE VARIANT -->
        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Category</label>
          <select
            name="category"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
            <option value="">Select Category</option>
            <% categories.forEach(category => { %>
              <option
                value="<%= category._id %>"
                <%= product.category._id.toString() === category._id.toString() ? "selected" : "" %>
              >
                <%= category.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">
            Size Variant
          </label>

          <select
            name="variantSize"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none"
          >
            <option value="">Select Size</option>
            <option value="S"  <%= product.variants?.[0]?.size === "S" ? "selected" : "" %>>S</option>
            <option value="L"  <%= product.variants?.[0]?.size === "L" ? "selected" : "" %>>L</option>
            <option value="XL" <%= product.variants?.[0]?.size === "XL" ? "selected" : "" %>>XL</option>
          </select>
        </div>

        <!-- ROW 3: REGULAR PRICE | SALE PRICE -->
        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Regular Price</label>
          <input
            type="number"
            name="regularPrice"
            value="<%= product.regularPrice %>"
            placeholder="Enter regular price"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Sale Price</label>
          <input
            type="number"
            name="salePrice"
            value="<%= product.salePrice %>"
            placeholder="Enter sale price"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <!-- ROW 4: QUANTITY | VARIANT QUANTITY -->
        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Quantity</label>
          <input
            type="number"
            name="quantity"
            value="<%= product.quantity %>"
            placeholder="Enter quantity"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700">Variant Quantity</label>
          <input
            type="number"
            name="variantQuantity"
            value="<%= product.variants && product.variants[0] ? product.variants[0].quantity : '' %>"
            placeholder="Enter quantity"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
        </div>

        <!-- ROW 5: DESCRIPTION (FULL WIDTH) -->
        <div class="md:col-span-2">
          <label class="block mb-2 text-sm font-semibold text-gray-700">Description</label>
          <textarea
            name="description"
            rows="4"
            placeholder="Enter product description"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          ><%= product.description %></textarea>
        </div>

        <!-- ROW 6: HIGHLIGHTS (FULL WIDTH) -->
        <div class="md:col-span-2">
          <label class="block mb-2 text-sm font-semibold text-gray-700">Product Highlights</label>
          <textarea
            name="highlights"
            rows="4"
            placeholder="Enter highlights separated by comma"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          ><%= product.highlights ? product.highlights.join(", ") : "" %></textarea>
          <p class="text-xs text-gray-500 mt-2">Example: Lightweight, DOT Certified, Scratch Resistant</p>
        </div>

        <!-- ROW 7: CURRENT IMAGES (FULL WIDTH) -->
        <div class="md:col-span-2">
          <label class="block mb-2 text-sm font-semibold text-gray-700">
            Current Product Images
          </label>

          <div class="flex flex-wrap gap-4">
            <% product.images.forEach((img, index) => { %>

              <div class="existing-image relative border border-gray-300 rounded-lg overflow-hidden bg-white p-1">

                <!-- Delete Button -->
                <button
                  type="button"
                  class="absolute top-1 right-1
                         flex items-center justify-center
                         w-5 h-5
                         rounded-full
                         bg-red-500/90
                         hover:bg-red-600
                         text-white
                         text-xs
                         font-bold
                         shadow-lg
                         transition-all duration-200
                         hover:scale-110"
                  onclick="deleteExistingImage('<%= img %>', this)"
                >
                  &times;
                </button>

                <img
                  src="<%= img %>"
                  class="w-24 h-24 object-cover rounded-lg"
                >
              </div>

            <% }) %>
          </div>

          <!-- Hidden input to store deleted images -->
          <input
            type="hidden"
            id="deletedImages"
            name="deletedImages"
            value=""
          >
        </div>

        <!-- IMAGES UPLOAD (FULL WIDTH) -->
        <div class="md:col-span-2">
          <label class="block mb-2 text-sm font-semibold text-gray-700">Add More Images (Total Images Must Be At Least 3)</label>
          <p class="text-xs text-gray-500 mb-2">You can click this multiple times to add images one by one. Existing images above are kept unless you delete them.</p>
          <input
            type="file"
            name="images"
            multiple
            accept="image/*"
            class="w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all duration-200"
          >
          <div id="imagePreviewContainer" class="flex flex-wrap gap-4 mt-4"></div>
        </div>

        <!-- SUBMIT BUTTONS -->
        <div class="md:col-span-2 flex gap-4 mt-4">
          <button
            type="submit"
            class="bg-orange-500 hover:bg-orange-600 text-white px-8 py-3 rounded-lg font-semibold transition"
          >
            Update Product
          </button>
          <a
            href="/admin/products"
            class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-8 py-3 rounded-lg font-semibold transition text-center"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>

    <!-- CROP MODAL -->
    <div
      id="cropModal"
      class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50"
    >
      <div class="bg-white p-6 rounded-2xl w-[500px]">
        <h2 class="text-xl font-bold mb-4">Crop Image</h2>
        <div class="w-full h-[300px]">
          <img id="cropImage" class="block max-w-full max-h-[300px]">
        </div>
        <div class="flex justify-end gap-3 mt-5">
          <button
            type="button"
            id="cropCancelBtn"
            class="bg-gray-300 px-5 py-2 rounded-lg"
          >
            Cancel
          </button>
          <button
            type="button"
            id="cropSaveBtn"
            class="bg-orange-500 text-white px-5 py-2 rounded-lg"
          >
            Crop
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Cropper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  let cropper;
  const imageInput = document.querySelector('input[name="images"]');
  const previewContainer = document.getElementById("imagePreviewContainer");
  const cropModal = document.getElementById("cropModal");
  const cropImage = document.getElementById("cropImage");
  const cropSaveBtn = document.getElementById("cropSaveBtn");
  const cropCancelBtn = document.getElementById("cropCancelBtn");

  let pendingFiles = [];   // files from the latest file-picker selection, awaiting crop
  let croppedFiles = [];   // ALL cropped images accumulated across every selection (persists)
  let currentIndex = 0;
  let deletedImages = [];

  function getExistingImageCount() {
    return document.querySelectorAll(".existing-image").length;
  }

  function getActiveNewImageCount() {
    return croppedFiles.filter(f => f !== null).length;
  }


  async function deleteExistingImage(imagePath, button) {

    const result = await Swal.fire({
      title: "Delete Image?",
      text: "Do you want to remove this image?",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#ef4444",
      cancelButtonColor: "#6b7280",
      confirmButtonText: "Yes, Delete",
      cancelButtonText: "Cancel"
    });

    if (!result.isConfirmed) {
      return;
    }

    const remainingAfterDelete = getExistingImageCount() - 1;
    const totalAfterDelete = remainingAfterDelete + getActiveNewImageCount();

    if (totalAfterDelete < 3) {

      Swal.fire({
        icon: "warning",
        title: "Minimum Images Required",
        text: "A product must have at least 3 images in total. Add a new image before removing this one."
      });

      return;
    }

    deletedImages.push(imagePath);

    document.getElementById("deletedImages").value =
      JSON.stringify(deletedImages);

    button.closest(".existing-image").remove();

    Swal.fire({
      icon: "success",
      title: "Deleted",
      text: "Image removed successfully.",
      timer: 1200,
      showConfirmButton: false
    });
  }


  imageInput.addEventListener("change", function (e) {
    // Each selection is ADDED to what's already cropped, not a replacement
    pendingFiles = Array.from(e.target.files);
    currentIndex = 0;

    if (pendingFiles.length > 0) {
      showCropper(pendingFiles[currentIndex]);
    }
  });

  function showCropper(file) {
    const reader = new FileReader();
    reader.onload = function (event) {
      cropImage.src = event.target.result;
      cropModal.classList.remove("hidden");
      cropModal.classList.add("flex");

      if (cropper) {
        cropper.destroy();
      }

      cropper = new Cropper(cropImage, {
        aspectRatio: 1,
        viewMode: 1,
        autoCropArea: 1,
      });
    };
    reader.readAsDataURL(file);
  }

  cropSaveBtn.addEventListener("click", function () {
    if (!cropper) return;

    const canvas = cropper.getCroppedCanvas({
      width: 800,
      height: 800
    });

    canvas.toBlob((blob) => {
      const fileName = `cropped-${Date.now()}-${croppedFiles.length}.png`;
      const file = new File([blob], fileName, { type: "image/png" });
      croppedFiles.push(file);

      const wrapper = document.createElement("div");
      wrapper.className = "relative";
      wrapper.dataset.index = croppedFiles.length - 1;

      const img = document.createElement("img");
      img.src = URL.createObjectURL(blob);
      img.className = "w-24 h-24 object-cover rounded-lg border border-gray-300";

      const removeBtn = document.createElement("button");
      removeBtn.innerHTML = "✕";
      removeBtn.type = "button";
      removeBtn.className = "absolute -top-2 -right-2 bg-red-500 hover:bg-red-600 text-white w-6 h-6 rounded-full text-sm";

      removeBtn.onclick = () => {
        console.log("delete button clicked")
        const idx = parseInt(wrapper.dataset.index);
        croppedFiles[idx] = null;
        wrapper.remove();
      };

      wrapper.appendChild(img);
      wrapper.appendChild(removeBtn);
      previewContainer.appendChild(wrapper);
    }, "image/png");

    cropper.destroy();
    currentIndex++;

    if (currentIndex < pendingFiles.length) {
      showCropper(pendingFiles[currentIndex]);
    } else {
      cropModal.classList.add("hidden");
      cropModal.classList.remove("flex");
      // Reset so the picker fires "change" again even if the same file is re-selected
      pendingFiles = [];
      currentIndex = 0;
      imageInput.value = "";
    }
  });

  cropCancelBtn.addEventListener("click", function () {
    cropModal.classList.add("hidden");
    cropModal.classList.remove("flex");
    if (cropper) {
      cropper.destroy();
    }
  });

  // Handle form submission — all validation shown via SweetAlert2 popups
  const form = document.querySelector("form");

  function showValidationError(text, focusEl) {
    Swal.fire({
      icon: "warning",
      title: "Validation Error",
      text: text
    });
    if (focusEl) {
      focusEl.focus();
    }
  }

  form.addEventListener("submit", function (e) {
    const nameField = form.querySelector('[name="name"]');
    const brandField = form.querySelector('[name="brand"]');
    const categoryField = form.querySelector('[name="category"]');
    const regularPriceField = form.querySelector('[name="regularPrice"]');
    const salePriceField = form.querySelector('[name="salePrice"]');
    const quantityField = form.querySelector('[name="quantity"]');
    const descriptionField = form.querySelector('[name="description"]');

    // PRODUCT NAME
    if (!nameField.value.trim()) {
      e.preventDefault();
      showValidationError("Product name is required.", nameField);
      return;
    }

    // BRAND
    if (!brandField.value.trim()) {
      e.preventDefault();
      showValidationError("Brand is required.", brandField);
      return;
    }

    // CATEGORY
    if (!categoryField.value) {
      e.preventDefault();
      showValidationError("Please select a category.", categoryField);
      return;
    }

    // REGULAR PRICE
    if (regularPriceField.value === "" || isNaN(regularPriceField.value)) {
      e.preventDefault();
      showValidationError("Regular price is required.", regularPriceField);
      return;
    }
    if (Number(regularPriceField.value) < 0) {
      e.preventDefault();
      showValidationError("Regular price cannot be negative.", regularPriceField);
      return;
    }

    // SALE PRICE
    if (salePriceField.value === "" || isNaN(salePriceField.value)) {
      e.preventDefault();
      showValidationError("Sale price is required.", salePriceField);
      return;
    }
    if (Number(salePriceField.value) < 0) {
      e.preventDefault();
      showValidationError("Sale price cannot be negative.", salePriceField);
      return;
    }
    if (Number(salePriceField.value) > Number(regularPriceField.value)) {
      e.preventDefault();
      showValidationError("Sale price cannot be greater than regular price.", salePriceField);
      return;
    }

    // QUANTITY
    if (quantityField.value === "" || isNaN(quantityField.value)) {
      e.preventDefault();
      showValidationError("Quantity is required.", quantityField);
      return;
    }
    if (Number(quantityField.value) < 0) {
      e.preventDefault();
      showValidationError("Quantity cannot be negative.", quantityField);
      return;
    }

    // DESCRIPTION
    if (!descriptionField.value.trim()) {
      e.preventDefault();
      showValidationError("Description is required.", descriptionField);
      return;
    }

    // IMAGES — total = existing images remaining + newly added images
    const activeFiles = croppedFiles.filter(f => f !== null);
    const totalImages = getExistingImageCount() + activeFiles.length;

    if (totalImages < 3) {
      e.preventDefault();
      showValidationError("A product must have at least 3 images in total.");
      return;
    }

    // Only touch the file input if new images were actually added
    if (activeFiles.length > 0) {
      const dt = new DataTransfer();
      activeFiles.forEach(file => dt.items.add(file));
      imageInput.files = dt.files;
    }
  });
</script>
</body>
</html>
