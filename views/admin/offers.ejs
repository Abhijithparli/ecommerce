<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Offer Management - Headshield Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 min-h-screen text-gray-900 font-sans">

<div class="flex w-full min-h-screen">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "offers"
  }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 ml-56 p-8">

    <!-- TOP HEADER -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900">Offers & Discounts</h1>
        <p class="text-sm text-gray-500 mt-1">Manage product offers, category discounts, and referral programs</p>
      </div>

      <a
        href="/admin/offers/add"
        class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create New Offer
      </a>
    </div>

    <!-- FLASH NOTIFICATIONS -->
    <% if (success) { %>
      <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded-xl mb-6 flex items-center justify-between">
        <span><%= success %></span>
        <button onclick="this.parentElement.remove()" class="text-green-800 font-bold">&times;</button>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded-xl mb-6 flex items-center justify-between">
        <span><%= error %></span>
        <button onclick="this.parentElement.remove()" class="text-red-800 font-bold">&times;</button>
      </div>
    <% } %>

    <!-- FILTER & SEARCH BAR -->
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-200 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <form action="/admin/offers" method="GET" class="w-full md:w-auto flex flex-wrap items-center gap-2">
        <input
          type="text"
          name="search"
          value="<%= search || '' %>"
          placeholder="Search by offer name..."
          class="px-4 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 w-64"
        >
        <select
          name="type"
          onchange="this.form.submit()"
          class="px-3 py-2 rounded-xl border border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          <option value="all" <%= !type || type === 'all' ? 'selected' : '' %>>All Types</option>
          <option value="product" <%= type === 'product' ? 'selected' : '' %>>Product Offers</option>
          <option value="category" <%= type === 'category' ? 'selected' : '' %>>Category Offers</option>
          <option value="referral" <%= type === 'referral' ? 'selected' : '' %>>Referral Offers</option>
        </select>
        <button
          type="submit"
          class="bg-gray-900 hover:bg-gray-800 text-white font-semibold px-4 py-2 rounded-xl text-sm transition"
        >
          Filter
        </button>
        <% if (search || (type && type !== 'all')) { %>
          <a href="/admin/offers" class="text-xs text-gray-500 hover:text-gray-900 underline ml-1">Reset</a>
        <% } %>
      </form>

      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
        Total: <%= totalOffers %> offers
      </div>
    </div>

    <!-- OFFERS TABLE -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
            <th class="py-4 px-6">Offer Name</th>
            <th class="py-4 px-6">Type & Target</th>
            <th class="py-4 px-6">Discount / Reward</th>
            <th class="py-4 px-6">Validity Period</th>
            <th class="py-4 px-6">Status</th>
            <th class="py-4 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% if (offers && offers.length > 0) { %>
            <% offers.forEach(offer => { %>
              <%
                const now = new Date();
                const isExpired = new Date(offer.endDate) < now;
                const isUpcoming = new Date(offer.startDate) > now;
              %>
              <tr class="hover:bg-gray-50/50 transition">
                <td class="py-4 px-6">
                  <div class="font-bold text-gray-900"><%= offer.name %></div>
                  <div class="text-xs text-gray-400">Created: <%= new Date(offer.createdAt).toLocaleDateString() %></div>
                </td>
                <td class="py-4 px-6">
                  <% if (offer.offerType === 'product') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                      📦 Product
                    </span>
                    <div class="text-xs font-semibold text-gray-700 mt-1">
                      <%= offer.product ? offer.product.name : 'Unknown Product' %>
                    </div>
                  <% } else if (offer.offerType === 'category') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800">
                      🏷️ Category
                    </span>
                    <div class="text-xs font-semibold text-gray-700 mt-1">
                      <%= offer.category ? offer.category.name : 'Unknown Category' %>
                    </div>
                  <% } else if (offer.offerType === 'referral') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                      🤝 Referral
                    </span>
                    <div class="text-xs text-gray-500 mt-1">Global program</div>
                  <% } %>
                </td>
                <td class="py-4 px-6">
                  <% if (offer.offerType === 'referral') { %>
                    <div class="text-xs font-medium text-gray-800">
                      Referrer: <strong class="text-green-600">₹<%= offer.referralReward %></strong>
                    </div>
                    <div class="text-xs font-medium text-gray-800">
                      Referee: <strong class="text-emerald-600">₹<%= offer.refereeReward %></strong>
                    </div>
                  <% } else { %>
                    <div class="text-base font-extrabold text-orange-600">
                      <%= offer.discountValue %>% OFF
                    </div>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-xs text-gray-600">
                  <div><strong>From:</strong> <%= new Date(offer.startDate).toLocaleDateString() %></div>
                  <div><strong>To:</strong> <%= new Date(offer.endDate).toLocaleDateString() %></div>
                </td>
                <td class="py-4 px-6">
                  <% if (isExpired) { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-gray-200 text-gray-700">Expired</span>
                  <% } else if (isUpcoming) { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-800">Upcoming</span>
                  <% } else if (offer.isActive) { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">Active</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">Inactive</span>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <form action="/admin/offers/toggle/<%= offer._id %>" method="POST" class="inline">
                      <button
                        type="submit"
                        class="px-2.5 py-1 rounded-lg text-xs font-semibold border <%= offer.isActive ? 'border-red-300 text-red-600 hover:bg-red-50' : 'border-green-300 text-green-600 hover:bg-green-50' %> transition"
                      >
                        <%= offer.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                    <a
                      href="/admin/offers/edit/<%= offer._id %>"
                      class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-200 text-gray-700 transition"
                    >
                      Edit
                    </a>
                    <button
                      onclick="confirmDelete('<%= offer._id %>', '<%= offer.name %>')"
                      class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-red-50 hover:bg-red-100 text-red-600 transition"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-12 text-gray-400">
                <p class="text-base font-semibold">No offers found.</p>
                <p class="text-xs mt-1">Create product, category, or referral offers to start giving discounts.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- PAGINATION -->
      <% if (totalPages > 1) { %>
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between items-center text-xs">
          <span class="text-gray-500">Page <%= currentPageNum %> of <%= totalPages %></span>
          <div class="flex gap-1">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="/admin/offers?page=<%= i %>&search=<%= search %>&type=<%= type %>"
                class="px-3 py-1.5 rounded-md font-bold <%= currentPageNum === i ? 'bg-orange-500 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50' %>"
              >
                <%= i %>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

  </main>
</div>

<script>
  function confirmDelete(id, name) {
    Swal.fire({
      title: 'Delete Offer?',
      text: `Are you sure you want to delete the offer "${name}"?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ea580c',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Yes, Delete'
    }).then((result) => {
      if (result.isConfirmed) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/offers/delete/${id}`;
        document.body.appendChild(form);
        form.submit();
      }
    });
  }
</script>

</body>
</html>
