<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Inventory Management - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

<div class="flex w-full">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "inventory"
  }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-8">
    <div class="w-full">

      <!-- HEADER -->
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
          Inventory Management <span class="text-lg font-normal text-gray-500">(Total: <%= totalProducts %>)</span>
        </h1>
      </div>

      <!-- FLASH NOTIFICATIONS -->
      <% if (success) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
          <%= success %>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
          <%= error %>
        </div>
      <% } %>

      <!-- SEARCH -->
      <div class="bg-white rounded-xl p-6 mb-8 border border-gray-200 shadow-sm">
        <form action="/admin/inventory" method="GET" class="flex gap-4 items-end">
          <div class="flex-1">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Search Product</label>
            <input
              type="text"
              name="search"
              value="<%= search %>"
              placeholder="Search by product name..."
              class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
          </div>
          <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-lg transition">
            Search
          </button>
          <a href="/admin/inventory" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-6 py-3 rounded-lg transition">
            Clear
          </a>
        </form>
      </div>

      <!-- PRODUCTS + VARIANTS STOCK TABLE -->
      <% if (products && products.length > 0) { %>
        <div class="space-y-6">
          <% products.forEach(product => { %>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
              <div class="flex items-center gap-4 p-5 border-b border-gray-100 bg-gray-50">
                <img src="<%= product.images[0] %>" class="w-14 h-14 object-cover rounded-lg border border-gray-200">
                <div>
                  <h3 class="font-bold text-gray-900 text-base"><%= product.name %></h3>
                  <p class="text-xs text-gray-500"><%= product.brand %></p>
                </div>
              </div>

              <table class="w-full text-left">
                <thead>
                  <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                    <th class="px-5 py-3">Size</th>
                    <th class="px-5 py-3">Current Stock</th>
                    <th class="px-5 py-3">Update Stock</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                  <% product.variants.forEach(variant => { %>
                    <tr>
                      <td class="px-5 py-3 font-semibold text-gray-800"><%= variant.size %></td>
                      <td class="px-5 py-3">
                        <% if (variant.stock <= 5) { %>
                          <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-bold rounded uppercase">
                            <%= variant.stock %> — Low Stock
                          </span>
                        <% } else { %>
                          <span class="text-gray-700 font-medium"><%= variant.stock %></span>
                        <% } %>
                      </td>
                      <td class="px-5 py-3">
                        <form action="/admin/inventory/<%= product._id %>/update-stock" method="POST" class="flex gap-2 items-center">
                          <input type="hidden" name="size" value="<%= variant.size %>">
                          <input
                            type="number"
                            name="quantity"
                            min="0"
                            value="<%= variant.stock %>"
                            class="w-24 px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
                          >
                          <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold px-4 py-1.5 rounded-lg transition">
                            Update
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="flex justify-center items-center gap-3 mt-8">
            <% if (currentPageNum > 1) { %>
              <a href="/admin/inventory?page=<%= currentPageNum - 1 %>&search=<%= search %>" class="px-4 py-2 bg-white hover:bg-gray-50 border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 shadow-sm transition">
                Previous
              </a>
            <% } %>
            <span class="text-xs text-gray-500">Page <%= currentPageNum %> of <%= totalPages %></span>
            <% if (currentPageNum < totalPages) { %>
              <a href="/admin/inventory?page=<%= currentPageNum + 1 %>&search=<%= search %>" class="px-4 py-2 bg-white hover:bg-gray-50 border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 shadow-sm transition">
                Next
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div class="bg-white rounded-xl border border-gray-200 p-12 text-center shadow-sm">
          <p class="text-gray-500">No products found.</p>
        </div>
      <% } %>

    </div>
  </div>

</div>

</body>
</html>