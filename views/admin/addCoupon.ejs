<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Coupon - Headshield Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen text-gray-900 font-sans">

<div class="flex w-full min-h-screen">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "coupons"
  }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 ml-56 p-8">

    <!-- BREADCRUMB & HEADER -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-1">
        <a href="/admin/coupons" class="hover:text-orange-500 transition">Coupons</a>
        <span>/</span>
        <span class="text-gray-900 font-medium">Create Coupon</span>
      </nav>
      <div class="flex justify-between items-center">
        <h1 class="text-3xl font-extrabold text-gray-900">Create New Coupon</h1>
        <a
          href="/admin/coupons"
          class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-xl text-sm font-semibold transition"
        >
          ← Back to Coupons
        </a>
      </div>
    </div>

    <!-- ERROR BANNER -->
    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded-xl mb-6">
        <%= error %>
      </div>
    <% } %>

    <!-- FORM CARD -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 max-w-2xl">
      <form action="/admin/coupons/add" method="POST" class="space-y-6" id="couponForm">
        
        <!-- Coupon Code -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
            Coupon Code <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="code"
            id="couponCode"
            required
            placeholder="e.g. SUMMER50"
            value="<%= formData.code || '' %>"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 font-mono uppercase text-base focus:outline-none focus:ring-2 focus:ring-orange-500"
            oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '')"
          >
          <p class="text-xs text-gray-400 mt-1">Letters and numbers only, converted to uppercase automatically.</p>
        </div>

        <!-- Discount Type & Value -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Discount Type <span class="text-red-500">*</span>
            </label>
            <select
              name="discountType"
              id="discountType"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-orange-500"
              onchange="handleTypeChange()"
            >
              <option value="percentage" <%= formData.discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
              <option value="flat" <%= formData.discountType === 'flat' ? 'selected' : '' %>>Flat Amount (₹)</option>
            </select>
          </div>

          <div>
            <label id="valueLabel" class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Discount Percentage (%) <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              name="discountValue"
              id="discountValue"
              required
              min="1"
              placeholder="e.g. 15"
              value="<%= formData.discountValue || '' %>"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
          </div>
        </div>

        <!-- Min Purchase & Max Discount -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Minimum Purchase (₹)
            </label>
            <input
              type="number"
              name="minPurchase"
              min="0"
              placeholder="0 (no minimum)"
              value="<%= formData.minPurchase || '' %>"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
            <p class="text-[11px] text-gray-400 mt-1">Order subtotal required to qualify.</p>
          </div>

          <div id="maxDiscountContainer">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Max Discount Cap (₹)
            </label>
            <input
              type="number"
              name="maxDiscount"
              id="maxDiscount"
              min="1"
              placeholder="Optional cap (e.g. 500)"
              value="<%= formData.maxDiscount || '' %>"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
            <p class="text-[11px] text-gray-400 mt-1">Maximum discount amount limit.</p>
          </div>
        </div>

        <!-- Expiry Date & Usage Limit -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Expiry Date <span class="text-red-500">*</span>
            </label>
            <input
              type="date"
              name="expiryDate"
              id="expiryDate"
              required
              value="<%= formData.expiryDate || '' %>"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
              Total Usage Limit
            </label>
            <input
              type="number"
              name="usageLimit"
              min="1"
              placeholder="Unlimited if empty"
              value="<%= formData.usageLimit || '' %>"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
            <p class="text-[11px] text-gray-400 mt-1">Max redemptions across all users.</p>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex gap-4 pt-4 border-t border-gray-100">
          <button
            type="submit"
            class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-md transition"
          >
            Create Coupon
          </button>
          <a
            href="/admin/coupons"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3.5 px-6 rounded-xl transition text-center"
          >
            Cancel
          </a>
        </div>

      </form>
    </div>

  </main>
</div>

<script>
  // Set minimum date to tomorrow
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const minDateStr = tomorrow.toISOString().split("T")[0];
  document.getElementById("expiryDate").min = minDateStr;

  function handleTypeChange() {
    const type = document.getElementById("discountType").value;
    const label = document.getElementById("valueLabel");
    const maxDiscountBox = document.getElementById("maxDiscountContainer");
    const valInput = document.getElementById("discountValue");

    if (type === "percentage") {
      label.innerHTML = 'Discount Percentage (%) <span class="text-red-500">*</span>';
      valInput.placeholder = "e.g. 15";
      valInput.max = "100";
      maxDiscountBox.style.display = "block";
    } else {
      label.innerHTML = 'Discount Amount (₹) <span class="text-red-500">*</span>';
      valInput.placeholder = "e.g. 250";
      valInput.removeAttribute("max");
      maxDiscountBox.style.display = "none";
    }
  }

  handleTypeChange();
</script>

</body>
</html>
