

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
 
</head>

<body class="bg-gray-100 text-gray-900 min-h-screen">

  
<div class="flex bg-gray-100 text-gray-900 min-h-screen">

  <!-- SIDEBAR -->
<%- include("../partials/sidebar", {
  currentPage: "products"
}) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-10">

<div class="max-w-7xl mx-auto">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8">

    <h1 class="text-3xl font-bold">
      Product Management
    </h1>

    <a
  href="/admin/products/add"
  class="
    bg-orange-500
    hover:bg-orange-600
   text-gray-900
    px-6 py-3
    rounded-lg
  "
>

  Add Product

</a>

  </div>


  <!-- SUCCESS -->
  <% if (success) { %>

    <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-3 rounded mb-4">
      <%= success %>
    </div>

  <% } %>


  <!-- ERROR -->
  <% if (error) { %>

    <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>

  <% } %>


  <!-- PRODUCT TABLE -->
<div class="
 bg-white
  rounded-2xl
  shadow-2xl
  overflow-hidden
  border border-gray-200
">

    <table class="w-full table-fixed">

      <!-- HEAD -->
    <thead class="bg-gray-800 text-gray-300 uppercase text-sm">

     <tr>

          <th class="px-6 py-4 text-left">
            Product
          </th>

          <th class="px-6 py-4 text-left">
            Category
          </th>

          <th class="px-6 py-4 text-left">
            Price
          </th>

          <th class="px-6 py-4 text-left">
            Quantity
          </th>

         <th class="px-6 py-4 text-left w-72">
  Images
</th>

<th class="px-6 py-4 text-left w-52">
  Actions
</th>

        </tr>

      </thead>


      <!-- BODY -->
      <tbody>

      <% if (products.length > 0) { %>

        <% products.forEach(product => { %>

       <tr class="
  border-b
  border-gray-200
  hover:bg-gray-50
  transition
  align-top
">

            <!-- NAME -->
            <td class="px-6 py-4">

              <div class="font-semibold text-lg text-gray-900">
                <%= product.name %>
              </div>

              <div class="text-sm text-gray-500 mt-1">
                <%= product.brand %>
              </div>

            </td>


            <!-- CATEGORY -->
            <td class="px-6 py-4">

              <%= product.category?.name %>

            </td>


            <!-- PRICE -->
            <td class="px-6 py-4">

              ₹<%= product.salePrice %>

            </td>


            <!-- QUANTITY -->
            <td class="px-6 py-4">

              <%= product.quantity %>

            </td>


            <!-- IMAGES -->
            <td class="px-6 py-4">

            <div class="flex flex-wrap gap-2 max-w-xs">

                <% product.images.forEach(image => { %>

                  <img
                    src="<%= image %>"
                   class="
  w-16
  h-16
  object-cover
  rounded-lg
  border
  border-gray-200
  shadow-sm
"
                  >

                <% }) %>

              </div>
              </td>

              <!-- ACTIONS -->

<td class="px-6 py-4">
<div class="flex items-center gap-3">

    <!-- EDIT -->
    <a
      href="/admin/products/<%= product._id %>/edit"
      class="
  bg-yellow-500
  hover:bg-yellow-600
  px-4 py-2
  rounded-lg
  text-sm
  font-medium
  transition
"
    >
      Edit
    </a>

    <!-- DELETE -->
    <form
      action="/admin/products/<%= product._id %>/delete"
      method="POST"
    >

      <button
        onclick="return confirm('Delete this product?')"
      class="
  bg-red-500
  hover:bg-red-600
  px-4 py-2
  rounded-lg
  text-sm
  font-medium
  transition
"
      >
        Delete
      </button>

    </form>

  </div>

</td>

          </tr>

        <% }) %>

      <% } else { %>

        <tr>

          <td colspan="5" class="text-center py-10 text-gray-400">

            No products found

          </td>

        </tr>

      <% } %>

      </tbody>

    </table>

  </div>

</div>

<!-- CROP MODAL -->
<div
  id="cropModal"
  class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50"
>

  <div class="bg-gray-800 p-6 rounded-xl max-w-3xl w-full">

    <h2 class="text-2xl font-bold mb-4">
      Crop Image
    </h2>

    <div class="max-h-[500px] overflow-hidden">

      <img
        id="cropImage"
        class="max-w-full"
      >

    </div>

    <div class="flex justify-end gap-4 mt-6">
<button
  type="button"
  id="cancelCrop"
        class="bg-gray-600 px-5 py-2 rounded"
      >
        Cancel
      </button>

<button
  type="button"
  id="cropBtn"
        class="bg-orange-500 px-5 py-2 rounded"
      >
        Crop
      </button>

    </div>

  </div>

</div>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"
/>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>

const imageInput = document.querySelector('input[name="images"]');

const previewContainer = document.getElementById(
  "imagePreviewContainer"
);

const cropModal = document.getElementById("cropModal");

const cropImage = document.getElementById("cropImage");

const cropBtn = document.getElementById("cropBtn");

const cancelCrop = document.getElementById("cancelCrop");

let cropper;

imageInput.addEventListener("change", function (e) {

  const files = e.target.files;

  if (!files.length) return;

  const file = files[0];

  const reader = new FileReader();

  reader.onload = function (event) {

    cropImage.src = event.target.result;

    cropModal.classList.remove("hidden");
    cropModal.classList.add("flex");

    if (cropper) {
  cropper.destroy();
} 
    cropper = new Cropper(cropImage, {

      aspectRatio: 1,
      viewMode: 1,
      autoCropArea: 1,
      zoomable: true
    });
  };

  reader.readAsDataURL(file);
});

cropBtn.addEventListener("click", function () {
if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({

    width: 800,
    height: 800
  });

  const image = document.createElement("img");

  image.src = canvas.toDataURL();

  image.className =
    "w-24 h-24 object-cover rounded-lg border";

  previewContainer.innerHTML = "";

  previewContainer.appendChild(image);

if (cropper) {
  cropper.destroy();
}

  cropModal.classList.add("hidden");
  cropModal.classList.remove("flex");
});

cancelCrop.addEventListener("click", function () {

  if (cropper) {
    cropper.destroy();
  }

  cropModal.classList.add("hidden");

  cropModal.classList.remove("flex");
});

</script>
  </div>

</div>
</body>
</html>
