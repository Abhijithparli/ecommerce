

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Custom Bootstrap pagination styling for light theme container */
    .pagination {
      display: flex;
      padding-left: 0;
      list-style: none;
    }
    .page-item {
      margin: 0 2px;
    }
    .page-link {
      position: relative;
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: #374151; /* text-gray-700 */
      background-color: #ffffff;
      border: 1px solid #d1d5db; /* border-gray-300 */
      border-radius: 0.375rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .page-link:hover {
      color: #111827; /* text-gray-900 */
      background-color: #f3f4f6; /* bg-gray-100 */
      border-color: #d1d5db;
    }
    .page-item.active .page-link {
      color: #ffffff;
      background-color: #f97316; /* bg-orange-500 */
      border-color: #f97316;
    }
    .page-item.disabled .page-link {
      color: #9ca3af; /* text-gray-400 */
      pointer-events: none;
      background-color: #f9fafb; /* bg-gray-50 */
      border-color: #e5e7eb;
      opacity: 0.6;
    }
  </style>
</head>

<body class="bg-gray-100 text-gray-900 min-h-screen">

  
<div class="flex bg-gray-100 text-gray-900 min-h-screen">

  <!-- SIDEBAR -->
<%- include("../partials/sidebar", {
  currentPage: "products"
}) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 ml-56 p-10">

<div class="max-w-7xl mx-auto">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8">

    <h1 class="text-3xl font-bold">
      Product Management <span class="text-lg font-normal text-gray-500">(Total: <%= totalProducts %>)</span>
    </h1>

    <a
  href="/admin/products/add"
  class="
    bg-orange-500
    hover:bg-orange-600
   text-gray-900
    px-6 py-3
    rounded-lg
  "
>

  Add Product

</a>

  </div>


  <!-- SUCCESS -->
  <% if (success) { %>

    <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-3 rounded mb-4">
      <%= success %>
    </div>

  <% } %>


  <!-- ERROR -->
  <% if (error) { %>

    <div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>

  <% } %>

  <!-- SEARCH BAR -->
  <div class="bg-white rounded-xl p-5 mb-6 border border-gray-200 shadow-sm">
    <form
      action="/admin/products"
      method="GET"
      class="flex gap-3"
    >
      <input
        type="text"
        name="search"
        value="<%= search %>"
        placeholder="Search products by name or brand..."
        class="flex-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500"
      >
      <!-- SEARCH BUTTON -->
      <button
        type="submit"
        class="bg-orange-500 hover:bg-orange-600 text-white px-6 rounded-lg font-semibold transition"
      >
        Search
      </button>
      <!-- CLEAR BUTTON -->
      <a
        href="/admin/products"
        class="bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-3 rounded-lg font-semibold transition text-center flex items-center justify-center"
      >
        Clear
      </a>
    </form>
  </div>


  <!-- PRODUCT TABLE -->
<div class="
 bg-white
  rounded-2xl
  shadow-2xl
  overflow-x-auto
  border border-gray-200
">

    <table class="w-full table-fixed min-w-[1000px]">

      <!-- HEAD -->
    <thead class="bg-gray-800 text-gray-300 uppercase text-sm">

     <tr>

          <th class="px-6 py-4 text-left">
            Product
          </th>

          <th class="px-6 py-4 text-left">
            Category
          </th>

          <th class="px-6 py-4 text-left">
            Price
          </th>

          <th class="px-6 py-4 text-left">
            Quantity
          </th>

         <th class="px-6 py-4 text-left w-72">
  Images
</th>

<th class="px-6 py-4 text-left w-72">
  Actions
</th>

        </tr>

      </thead>


      <!-- BODY -->
      <tbody>

      <% if (products.length > 0) { %>

        <% products.forEach(product => { %>

       <tr class="
  border-b
  border-gray-200
  hover:bg-gray-50
  transition
  align-top
">

            <!-- NAME -->
            <td class="px-6 py-4">

              <div class="font-semibold text-lg text-gray-900">
                <%= product.name %>
              </div>

              <div class="text-sm text-gray-500 mt-1">
                <%= product.brand %>
              </div>

            </td>


            <!-- CATEGORY -->
            <td class="px-6 py-4">

              <%= product.category?.name %>

            </td>


            <!-- PRICE -->
            <td class="px-6 py-4">

              ₹<%= product.salePrice %>

            </td>


            <!-- QUANTITY -->
            <td class="px-6 py-4">

              <%= product.quantity %>

            </td>


            <!-- IMAGES -->
            <td class="px-6 py-4">

            <div class="flex flex-wrap gap-2 max-w-xs">

                <% product.images.forEach(image => { %>

                  <img
                    src="<%= image %>"
                   class="
  w-16
  h-16
  object-cover
  rounded-lg
  border
  border-gray-200
  shadow-sm
"
                  >

                <% }) %>

              </div>
              </td>

              <!-- ACTIONS -->

<td class="px-6 py-4">
<div class="flex items-center gap-3">

    <!-- EDIT -->
    <a
      href="/admin/products/<%= product._id %>/edit"
      class="
  bg-yellow-500
  hover:bg-yellow-600
  px-4 py-2
  rounded-lg
  text-sm
  font-medium
  transition
"
    >
      Edit
    </a>

    <!-- DELETE -->
    <form
      action="/admin/products/<%= product._id %>/delete"
      method="POST"
    >

      <button
        type="button"
        onclick="openDeleteModal(this)"
      class="
  bg-red-500
  hover:bg-red-600
  px-4 py-2
  rounded-lg
  text-sm
  font-medium
  transition
"
      >
        Delete
      </button>

    </form>

    <!-- BLOCK / UNBLOCK -->
    <form
      action="/admin/products/<%= product.isBlocked ? 'unblock' : 'block' %>/<%= product._id %>"
      method="POST"
    >
      <button
        type="submit"
        class="px-4 py-2 rounded-lg text-sm font-medium transition text-white <%= product.isBlocked ? 'bg-green-600 hover:bg-green-700' : 'bg-orange-500 hover:bg-orange-600' %>"
      >
        <%= product.isBlocked ? 'Unblock' : 'Block' %>
      </button>
    </form>

  </div>

</td>

          </tr>

        <% }) %>

      <% } else { %>

        <tr>

          <td colspan="5" class="text-center py-10 text-gray-400">

            No products found

          </td>

        </tr>

      <% } %>

      </tbody>

    </table>

  </div>

  <!-- PAGINATION -->
  <% if (totalPages > 1) { %>
  <div class="flex justify-center items-center py-6">
    <nav aria-label="Page navigation">
      <ul class="pagination">
        <!-- PREVIOUS -->
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <a
            class="page-link"
            href="/admin/products?page=<%= currentPage - 1 %>&search=<%= search %>"
          >
            Previous
          </a>
        </li>

        <!-- PAGE NUMBERS -->
        <% for(let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a
              class="page-link"
              href="/admin/products?page=<%= i %>&search=<%= search %>"
            >
              <%= i %>
            </a>
          </li>
        <% } %>

        <!-- NEXT -->
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <a
            class="page-link"
            href="/admin/products?page=<%= currentPage + 1 %>&search=<%= search %>"
          >
            Next
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <% } %>

</div>

<!-- CROP MODAL -->
<div
  id="cropModal"
  class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50"
>

  <div class="bg-gray-800 p-6 rounded-xl max-w-3xl w-full">

    <h2 class="text-2xl font-bold mb-4">
      Crop Image
    </h2>

    <div class="max-h-[500px] overflow-hidden">

      <img
        id="cropImage"
        class="max-w-full"
      >

    </div>

    <div class="flex justify-end gap-4 mt-6">
<button
  type="button"
  id="cancelCrop"
        class="bg-gray-600 px-5 py-2 rounded"
      >
        Cancel
      </button>

<button
  type="button"
  id="cropBtn"
        class="bg-orange-500 px-5 py-2 rounded"
      >
        Crop
      </button>

    </div>

  </div>

</div>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"
/>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<script>

const imageInput = document.querySelector('input[name="images"]');

const previewContainer = document.getElementById(
  "imagePreviewContainer"
);

const cropModal = document.getElementById("cropModal");

const cropImage = document.getElementById("cropImage");

const cropBtn = document.getElementById("cropBtn");

const cancelCrop = document.getElementById("cancelCrop");

let cropper;

imageInput.addEventListener("change", function (e) {

  const files = e.target.files;

  if (!files.length) return;

  const file = files[0];

  const reader = new FileReader();

  reader.onload = function (event) {

    cropImage.src = event.target.result;

    cropModal.classList.remove("hidden");
    cropModal.classList.add("flex");

    if (cropper) {
  cropper.destroy();
} 
    cropper = new Cropper(cropImage, {

      aspectRatio: 1,
      viewMode: 1,
      autoCropArea: 1,
      zoomable: true
    });
  };

  reader.readAsDataURL(file);
});

cropBtn.addEventListener("click", function () {
if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({

    width: 800,
    height: 800
  });

  const image = document.createElement("img");

  image.src = canvas.toDataURL();

  image.className =
    "w-24 h-24 object-cover rounded-lg border";

  previewContainer.innerHTML = "";

  previewContainer.appendChild(image);

if (cropper) {
  cropper.destroy();
}

  cropModal.classList.add("hidden");
  cropModal.classList.remove("flex");
});

cancelCrop.addEventListener("click", function () {

  if (cropper) {
    cropper.destroy();
  }

  cropModal.classList.add("hidden");

  cropModal.classList.remove("flex");
});

</script>

<!-- DELETE CONFIRMATION MODAL -->
<div
  id="deleteModal"
  class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50"
>
  <div class="bg-white w-full max-w-md rounded-2xl p-6 shadow-2xl border border-gray-100">
    <h2 class="text-xl font-bold mb-3 text-gray-900">
      Delete Product
    </h2>
    <p class="text-gray-600 mb-6">
      Are you sure you want to delete this product? This action cannot be undone.
    </p>
    <div class="flex justify-end gap-3">
      <button
        onclick="closeDeleteModal()"
        class="px-5 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold transition"
      >
        Cancel
      </button>
      <button
        id="confirmDeleteBtn"
        class="px-5 py-2 rounded-lg bg-red-500 hover:bg-red-600 text-white font-semibold transition"
      >
        Delete
      </button>
    </div>
  </div>
</div>

<script>
let selectedForm = null;

function openDeleteModal(button) {
  selectedForm = button.closest("form");
  const modal = document.getElementById("deleteModal");
  modal.classList.remove("hidden");
  modal.classList.add("flex");   
}

function closeDeleteModal() {
  const modal = document.getElementById("deleteModal");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

document
  .getElementById("confirmDeleteBtn")
  .addEventListener("click", function () {
    if (selectedForm) {
      selectedForm.submit();
    }
  });
</script>

  </div>

</div>
</body>
</html>
