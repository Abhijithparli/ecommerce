<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Category - Headshield Admin</title>

  <!-- TAILWIND -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- SWEETALERT2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 min-h-screen text-gray-900">

<div class="flex w-full min-h-screen">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "categories"
  }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 ml-56 p-6">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="/admin/categories" class="hover:text-orange-500 transition">Categories</a>
          <span>/</span>
          <span class="text-gray-800 font-medium">Add Category</span>
        </nav>
        <h1 class="text-3xl font-bold text-gray-900">Add Category</h1>
      </div>

      <a
        href="/admin/categories"
        class="bg-gray-600 hover:bg-gray-500 text-white px-5 py-2.5 rounded-lg font-semibold transition inline-flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Categories
      </a>
    </div>

    <!-- FLASH TOP ERROR BANNER -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div id="topErrorBanner" class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded-xl mb-6 max-w-3xl flex items-center gap-3">
        <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm font-medium"><%= error %></span>
      </div>
    <% } %>

    <!-- FORM CARD (Matching categories.ejs dark container) -->
    <div class="bg-gray-800 rounded-xl p-8 shadow-lg max-w-3xl text-white">

      <form
        id="addCategoryForm"
        action="/admin/categories/add"
        method="POST"
        novalidate
      >

        <!-- CATEGORY NAME -->
        <div class="mb-6">
          <div class="flex justify-between items-center mb-2">
            <label for="categoryName" class="block text-sm font-semibold text-gray-200">
              Category Name <span class="text-orange-500">*</span>
            </label>
            <span id="nameCounter" class="text-xs text-gray-400">0 / 50</span>
          </div>

          <input
            type="text"
            id="categoryName"
            name="name"
            placeholder="Enter category name (e.g. Full Face, Modular, Off-Road)"
            value="<%= (typeof formData !== 'undefined' && formData && formData.name) ? formData.name : '' %>"
            maxlength="50"
            autocomplete="off"
            class="w-full px-4 py-3 rounded-lg bg-gray-700 border <%= (typeof errors !== 'undefined' && errors?.name) ? 'border-red-500 ring-2 ring-red-500/30' : 'border-gray-600' %> text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all duration-200"
          >

          <!-- INLINE ERROR DIRECTLY UNDER CATEGORY NAME LINE -->
          <p
            id="nameError"
            class="text-red-400 text-sm mt-1.5 font-medium flex items-center gap-1.5 <%= (typeof errors !== 'undefined' && errors?.name) ? '' : 'hidden' %>"
          >
            <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span id="nameErrorText"><%= (typeof errors !== 'undefined' && errors?.name) ? errors.name : '' %></span>
          </p>

          <p class="text-xs text-gray-400 mt-1">
            3 to 50 characters with letters, numbers, spaces, hyphens (-), &amp; ampersands (&amp;).
          </p>
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-2">
            <label for="categoryDescription" class="block text-sm font-semibold text-gray-200">
              Description <span class="text-orange-500">*</span>
            </label>
            <span id="descCounter" class="text-xs text-gray-400">0 / 500</span>
          </div>

          <textarea
            id="categoryDescription"
            name="description"
            rows="4"
            placeholder="Enter category description..."
            maxlength="500"
            class="w-full px-4 py-3 rounded-lg bg-gray-700 border <%= (typeof errors !== 'undefined' && errors?.description) ? 'border-red-500 ring-2 ring-red-500/30' : 'border-gray-600' %> text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all duration-200"
          ><%= (typeof formData !== 'undefined' && formData && formData.description) ? formData.description : '' %></textarea>

          <!-- INLINE ERROR DIRECTLY UNDER DESCRIPTION LINE -->
          <p
            id="descriptionError"
            class="text-red-400 text-sm mt-1.5 font-medium flex items-center gap-1.5 <%= (typeof errors !== 'undefined' && errors?.description) ? '' : 'hidden' %>"
          >
            <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span id="descErrorText"><%= (typeof errors !== 'undefined' && errors?.description) ? errors.description : '' %></span>
          </p>

          <p class="text-xs text-gray-400 mt-1">
            5 to 500 characters describing the category.
          </p>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center gap-4 pt-4 border-t border-gray-700">
          <button
            type="submit"
            id="submitBtn"
            class="bg-orange-500 hover:bg-orange-600 active:scale-[0.99] text-white px-6 py-3 rounded-lg font-semibold transition flex items-center justify-center gap-2 shadow"
          >
            <span id="submitBtnText">Add Category</span>
            <svg id="submitSpinner" class="hidden w-5 h-5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>

          <a
            href="/admin/categories"
            class="bg-gray-600 hover:bg-gray-500 text-white px-6 py-3 rounded-lg font-semibold transition"
          >
            Cancel
          </a>
        </div>

      </form>
    </div>

  </main>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("addCategoryForm");
  const nameInput = document.getElementById("categoryName");
  const descInput = document.getElementById("categoryDescription");
  const nameError = document.getElementById("nameError");
  const nameErrorText = document.getElementById("nameErrorText");
  const descError = document.getElementById("descriptionError");
  const descErrorText = document.getElementById("descErrorText");
  const nameCounter = document.getElementById("nameCounter");
  const descCounter = document.getElementById("descCounter");
  const submitBtn = document.getElementById("submitBtn");
  const submitBtnText = document.getElementById("submitBtnText");
  const submitSpinner = document.getElementById("submitSpinner");

  const validCharsRegex = /^[a-zA-Z0-9\s\-&]+$/;
  const hasLetterRegex = /[a-zA-Z]/;

  updateCounters();

  // Helper: Set error styling and text under the line
  function setError(input, errorContainer, textElement, message) {
    input.classList.remove("border-gray-600");
    input.classList.add("border-red-500", "ring-2", "ring-red-500/30");
    textElement.textContent = message;
    errorContainer.classList.remove("hidden");
  }

  // Helper: Clear error styling and text under the line
  function clearError(input, errorContainer, textElement) {
    input.classList.remove("border-red-500", "ring-2", "ring-red-500/30");
    input.classList.add("border-gray-600");
    textElement.textContent = "";
    errorContainer.classList.add("hidden");
  }

  // Validation functions
  function validateName() {
    const value = nameInput.value.trim();

    if (!value) {
      setError(nameInput, nameError, nameErrorText, "Category name is required.");
      return false;
    }

    if (value.length < 3) {
      setError(nameInput, nameError, nameErrorText, "Category name must be at least 3 characters long.");
      return false;
    }

    if (value.length > 50) {
      setError(nameInput, nameError, nameErrorText, "Category name must not exceed 50 characters.");
      return false;
    }

    if (!validCharsRegex.test(value)) {
      setError(nameInput, nameError, nameErrorText, "Only letters, numbers, spaces, hyphens (-), and ampersands (&) are allowed.");
      return false;
    }

    if (!hasLetterRegex.test(value)) {
      setError(nameInput, nameError, nameErrorText, "Category name must contain at least one letter.");
      return false;
    }

    clearError(nameInput, nameError, nameErrorText);
    return true;
  }

  function validateDescription() {
    const value = descInput.value.trim();

    if (!value) {
      setError(descInput, descError, descErrorText, "Description is required.");
      return false;
    }

    if (value.length < 5) {
      setError(descInput, descError, descErrorText, "Description must be at least 5 characters long.");
      return false;
    }

    if (value.length > 500) {
      setError(descInput, descError, descErrorText, "Description cannot exceed 500 characters.");
      return false;
    }

    clearError(descInput, descError, descErrorText);
    return true;
  }

  function updateCounters() {
    if (nameInput && nameCounter) {
      nameCounter.textContent = `${nameInput.value.length} / 50`;
    }
    if (descInput && descCounter) {
      descCounter.textContent = `${descInput.value.length} / 500`;
    }
  }

  // Real-time live input listeners
  nameInput.addEventListener("input", function () {
    updateCounters();
    if (nameInput.value.trim().length > 0) {
      validateName();
    } else {
      setError(nameInput, nameError, nameErrorText, "Category name is required.");
    }
  });

  nameInput.addEventListener("blur", function () {
    validateName();
  });

  descInput.addEventListener("input", function () {
    updateCounters();
    if (descInput.value.trim().length > 0) {
      validateDescription();
    } else {
      setError(descInput, descError, descErrorText, "Description is required.");
    }
  });

  descInput.addEventListener("blur", function () {
    validateDescription();
  });

  function setLoading(loading) {
    if (loading) {
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-75", "cursor-not-allowed");
      submitBtnText.textContent = "Adding...";
      submitSpinner.classList.remove("hidden");
    } else {
      submitBtn.disabled = false;
      submitBtn.classList.remove("opacity-75", "cursor-not-allowed");
      submitBtnText.textContent = "Add Category";
      submitSpinner.classList.add("hidden");
    }
  }

  // Submit listener
  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    const isNameValid = validateName();
    const isDescValid = validateDescription();

    if (!isNameValid || !isDescValid) {
      const firstError = nameErrorText.textContent || descErrorText.textContent || "Please correct the errors in the form.";
      
      Swal.fire({
        icon: "warning",
        title: "Validation Error",
        text: firstError,
        background: "#1f2937",
        color: "#ffffff",
        confirmButtonColor: "#f97316"
      });

      if (!isNameValid) {
        nameInput.focus();
      } else {
        descInput.focus();
      }
      return;
    }

    setLoading(true);

    try {
      const payload = {
        name: nameInput.value.trim(),
        description: descInput.value.trim()
      };

      const response = await fetch("/admin/categories/add", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        setLoading(false);

        // Show inline errors directly under the fields from backend response
        if (data.errors) {
          if (data.errors.name) {
            setError(nameInput, nameError, nameErrorText, data.errors.name);
            nameInput.focus();
          }
          if (data.errors.description) {
            setError(descInput, descError, descErrorText, data.errors.description);
          }
        }

        Swal.fire({
          icon: "error",
          title: "Failed to Add Category",
          text: data.message || "Please check your inputs and try again.",
          background: "#1f2937",
          color: "#ffffff",
          confirmButtonColor: "#f97316"
        });
        return;
      }

      // Success feedback and redirection
      Swal.fire({
        icon: "success",
        title: "Success!",
        text: data.message || "Category added successfully.",
        background: "#1f2937",
        color: "#ffffff",
        showConfirmButton: false,
        timer: 1500
      }).then(() => {
        window.location.href = data.redirectUrl || "/admin/categories";
      });

    } catch (err) {
      console.error("Fetch submission error:", err);
      form.submit();
    }
  });
});
</script>

</body>
</html>