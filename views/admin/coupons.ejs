<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Coupon Management - Headshield Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 min-h-screen text-gray-900 font-sans">

<div class="flex w-full min-h-screen">

  <!-- SIDEBAR -->
  <%- include("../partials/sidebar", {
    currentPage: "coupons"
  }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 ml-56 p-8">

    <!-- TOP HEADER -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900">Coupons</h1>
        <p class="text-sm text-gray-500 mt-1">Manage promotional coupons, discounts, and expiration rules</p>
      </div>

      <a
        href="/admin/coupons/add"
        class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create Coupon
      </a>
    </div>

    <!-- FLASH NOTIFICATIONS -->
    <% if (success) { %>
      <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded-xl mb-6 flex items-center justify-between">
        <span><%= success %></span>
        <button onclick="this.parentElement.remove()" class="text-green-800 font-bold">&times;</button>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded-xl mb-6 flex items-center justify-between">
        <span><%= error %></span>
        <button onclick="this.parentElement.remove()" class="text-red-800 font-bold">&times;</button>
      </div>
    <% } %>

    <!-- FILTER & SEARCH BAR -->
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-200 mb-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <form action="/admin/coupons" method="GET" class="w-full sm:w-96 flex items-center gap-2">
        <input
          type="text"
          name="search"
          value="<%= search || '' %>"
          placeholder="Search by coupon code..."
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
        <button
          type="submit"
          class="bg-gray-900 hover:bg-gray-800 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition"
        >
          Search
        </button>
        <% if (search) { %>
          <a href="/admin/coupons" class="text-xs text-gray-500 hover:text-gray-900 underline">Clear</a>
        <% } %>
      </form>

      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
        Total: <%= totalCoupons %> coupons
      </div>
    </div>

    <!-- COUPONS TABLE -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-gray-50 text-gray-500 uppercase text-[11px] font-bold tracking-wider border-b border-gray-200">
              <th class="px-6 py-4">Code</th>
              <th class="px-6 py-4">Discount</th>
              <th class="px-6 py-4">Min Purchase</th>
              <th class="px-6 py-4">Usage</th>
              <th class="px-6 py-4">Expires On</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if (coupons && coupons.length > 0) { %>
              <% coupons.forEach(coupon => { 
                   const isExpired = new Date() > new Date(coupon.expiryDate);
              %>
                <tr class="hover:bg-gray-50/70 transition">
                  <!-- Code -->
                  <td class="px-6 py-4 font-mono font-bold text-gray-900 text-base">
                    <span class="px-3 py-1 bg-orange-50 text-orange-600 rounded-lg border border-orange-200">
                      <%= coupon.code %>
                    </span>
                  </td>

                  <!-- Discount -->
                  <td class="px-6 py-4">
                    <% if (coupon.discountType === 'percentage') { %>
                      <span class="font-bold text-gray-900"><%= coupon.discountValue %>% OFF</span>
                      <% if (coupon.maxDiscount) { %>
                        <span class="block text-xs text-gray-400">Up to ₹<%= coupon.maxDiscount %></span>
                      <% } %>
                    <% } else { %>
                      <span class="font-bold text-gray-900">₹<%= coupon.discountValue %> OFF</span>
                    <% } %>
                  </td>

                  <!-- Min Purchase -->
                  <td class="px-6 py-4 text-gray-600">
                    <%= coupon.minPurchase > 0 ? '₹' + coupon.minPurchase : 'None' %>
                  </td>

                  <!-- Usage -->
                  <td class="px-6 py-4 text-gray-600">
                    <span class="font-semibold text-gray-900"><%= coupon.usedCount %></span>
                    <%= coupon.usageLimit ? `/ ${coupon.usageLimit}` : ' used' %>
                  </td>

                  <!-- Expiry Date -->
                  <td class="px-6 py-4">
                    <span class="<%= isExpired ? 'text-red-600 font-semibold' : 'text-gray-700' %>">
                      <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
                    </span>
                    <% if (isExpired) { %>
                      <span class="block text-[10px] text-red-500 uppercase font-bold tracking-wider">Expired</span>
                    <% } %>
                  </td>

                  <!-- Status Badge -->
                  <td class="px-6 py-4">
                    <% if (isExpired) { %>
                      <span class="px-2.5 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold">Expired</span>
                    <% } else if (coupon.isActive) { %>
                      <span class="px-2.5 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">Active</span>
                    <% } else { %>
                      <span class="px-2.5 py-1 bg-gray-200 text-gray-700 rounded-full text-xs font-bold">Inactive</span>
                    <% } %>
                  </td>

                  <!-- Actions -->
                  <td class="px-6 py-4 text-right space-x-2">
                    <a
                      href="/admin/coupons/edit/<%= coupon._id %>"
                      class="inline-block px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition"
                    >
                      Edit
                    </a>

                    <!-- Toggle Active Form -->
                    <form action="/admin/coupons/toggle/<%= coupon._id %>" method="POST" class="inline m-0">
                      <button
                        type="submit"
                        class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= coupon.isActive ? 'bg-amber-100 hover:bg-amber-200 text-amber-800' : 'bg-green-100 hover:bg-green-200 text-green-800' %>"
                      >
                        <%= coupon.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>

                    <!-- Delete Form -->
                    <form action="/admin/coupons/delete/<%= coupon._id %>" method="POST" class="inline m-0" onsubmit="return confirm('Are you sure you want to delete coupon <%= coupon.code %>? This cannot be undone.')">
                      <button
                        type="submit"
                        class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg text-xs font-semibold transition"
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                  <div class="max-w-sm mx-auto space-y-2">
                    <p class="text-base font-semibold text-gray-700">No coupons found</p>
                    <p class="text-xs">Create your first discount coupon to start offering deals to customers.</p>
                    <a href="/admin/coupons/add" class="inline-block mt-3 px-4 py-2 bg-orange-500 text-white rounded-lg text-xs font-bold">Create Coupon</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <% if (totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
          <div>Page <%= currentPageNum %> of <%= totalPages %></div>
          <div class="flex gap-1">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="/admin/coupons?page=<%= i %>&search=<%= search || '' %>"
                class="px-3 py-1 rounded-lg border text-xs font-bold transition <%= i === currentPageNum ? 'bg-orange-500 border-orange-500 text-white' : 'bg-white border-gray-200 text-gray-700 hover:bg-gray-50' %>"
              >
                <%= i %>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

  </main>
</div>

</body>
</html>
