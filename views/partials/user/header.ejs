<% const currentUser = (typeof user !== 'undefined' && user) ? user : null; %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  window.isLoggedIn = <%= currentUser ? 'true' : 'false' %>;
  
  function handleGuestAction(event, actionName) {
    if (!window.isLoggedIn) {
      event.preventDefault();
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: 'Login Required',
          text: `Please sign in to access ${actionName || 'this feature'}.`,
          icon: 'info',
          iconColor: '#f97316',
          showCancelButton: true,
          confirmButtonText: 'Login Now',
          cancelButtonText: 'Cancel',
          customClass: {
            popup: 'headshield-swal'
          }
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = "/login";
          }
        });
      } else {
        window.location.href = "/login";
      }
    }
  }
</script>

<header class="bg-slate-900 border-b border-white/10 sticky top-0 z-50 shadow-md">
  <div class="w-full px-8 py-4 flex items-center justify-between">
    
    <!-- Logo & Title -->
 <a href="/" class="flex items-center gap-4">
  <img
    src="/icon/symbol.jpg"
    alt="HeadShield Logo"
    class="w-20 h-28 object-contain"
  />

  <span class="text-3xl font-bold text-white">
    HEAD-SHIELD
  </span>
</a>

    <!-- Navigation Menu (Figma) -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-semibold tracking-wider uppercase text-gray-300 hover:text-orange-500 transition duration-200">
        HOME
      </a>
      <a href="/products?category=fullface" class="text-sm font-semibold tracking-wider uppercase text-gray-300 hover:text-orange-500 transition duration-200">
        FULL FACE
      </a>
      <a href="/products?category=half%20face" class="text-sm font-semibold tracking-wider uppercase text-gray-300 hover:text-orange-500 transition duration-200">
        OPEN FACE
      </a>
      <a href="/products" class="text-sm font-semibold tracking-wider uppercase text-gray-300 hover:text-orange-500 transition duration-200">
        PRODUCTS
      </a>
      <a href="/about" class="text-sm font-semibold tracking-wider uppercase text-gray-300 hover:text-orange-500 transition duration-200">
        ABOUT
      </a>
    </nav>

    <!-- Header Action Icons -->
    <div class="flex items-center gap-6">
      
      <!-- Wishlist -->
      <a href="/wishlist" onclick="handleGuestAction(event, 'wishlist')" class="text-gray-300 hover:text-orange-500 transition duration-200 text-2xl" title="Wishlist">
        ♡
      </a>

      <!-- Shopping Cart -->
      <a href="/cart" onclick="handleGuestAction(event, 'cart')" class="text-gray-300 hover:text-orange-500 transition duration-200 text-2xl relative" title="Cart">
        🛍
      </a>

      <!-- Profile / Auth State -->
      <% if (currentUser) { %>
        <div class="flex items-center gap-4">
          <a href="/profile" class="text-gray-300 hover:text-orange-500 transition duration-200 text-xl" title="My Profile">
            👤
          </a>
          <form action="/logout" method="POST" class="inline m-0">
            <button type="submit" class="text-sm bg-red-600/20 border border-red-500/40 text-red-400 px-3 py-1.5 rounded-lg hover:bg-red-600 hover:text-white transition duration-200 font-medium">
              Logout
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="flex items-center gap-3">
          <a href="/login" class="text-sm bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg font-semibold transition duration-200">
            Login
          </a>
          <a href="/signup" class="text-sm border border-orange-500/40 text-orange-400 hover:bg-orange-500 hover:text-white px-4 py-2 rounded-lg font-semibold transition duration-200">
            Register
          </a>
        </div>
      <% } %>

    </div>

  </div>
</header>