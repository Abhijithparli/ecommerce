<%
  // Shared Add / Edit address modal.
  // Usage: include("../partials/user/addressModal", { redirectTo: "/checkout" })
  // Open with openAddressModal() for a new address, or openAddressModal(addressObject) to edit.
  const modalRedirectTo = (typeof redirectTo !== 'undefined' && redirectTo) ? redirectTo : '';
%>
<div id="addressModal" class="hidden fixed inset-0 z-[100] bg-black/70 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="addressModalTitle">
  <div class="bg-[#13131a] text-gray-200 border border-white/10 w-full max-w-xl max-h-[90vh] overflow-y-auto rounded-2xl shadow-2xl p-6 sm:p-8">

    <div class="flex justify-between items-center mb-6 pb-3 border-b border-white/10">
      <h2 id="addressModalTitle" class="text-xl font-bold text-white">Add Delivery Address</h2>
      <button type="button" onclick="closeAddressModal()" class="text-gray-400 hover:text-white text-lg" aria-label="Close">✕</button>
    </div>

    <form id="addressModalForm" method="POST" action="/profile/addresses/add" novalidate class="space-y-4">
      <% if (modalRedirectTo) { %>
        <input type="hidden" name="redirectTo" value="<%= modalRedirectTo %>">
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="form-group">
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Full Name</label>
          <input name="name" placeholder="John Doe" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
          <p class="text-red-400 text-xs mt-1 hidden"></p>
        </div>
        <div class="form-group">
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Phone Number</label>
          <input name="phone" placeholder="10-digit mobile number" maxlength="10" inputmode="numeric" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
          <p class="text-red-400 text-xs mt-1 hidden"></p>
        </div>
      </div>

      <div class="form-group">
        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Street Address</label>
        <input name="street" placeholder="House/Flat number, building, street, area" maxlength="100" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
        <p class="text-red-400 text-xs mt-1 hidden"></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="form-group">
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">City</label>
          <input name="city" placeholder="City" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
          <p class="text-red-400 text-xs mt-1 hidden"></p>
        </div>
        <div class="form-group">
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">State</label>
          <input name="state" placeholder="State" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
          <p class="text-red-400 text-xs mt-1 hidden"></p>
        </div>
        <div class="form-group">
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Pincode</label>
          <input name="pincode" placeholder="6-digit PIN" maxlength="6" inputmode="numeric" class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 transition text-sm">
          <p class="text-red-400 text-xs mt-1 hidden"></p>
        </div>
      </div>

      <div class="pt-1">
        <label class="inline-flex items-center gap-2.5 text-sm text-gray-300 cursor-pointer select-none">
          <input type="checkbox" name="isDefault" class="w-4 h-4 rounded bg-white/10 border-white/20 text-orange-500 focus:ring-0 cursor-pointer">
          <span>Set as default delivery address</span>
        </label>
      </div>

      <div class="flex items-center gap-3 pt-4 border-t border-white/10">
        <button type="submit" id="addressModalSubmit" class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-xl transition shadow text-sm">
          Save Address
        </button>
        <button type="button" onclick="closeAddressModal()" class="flex-1 bg-white/10 hover:bg-white/15 text-gray-300 hover:text-white font-semibold py-3 rounded-xl transition text-sm">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById("addressModal");
    const form = document.getElementById("addressModalForm");
    const title = document.getElementById("addressModalTitle");
    const submitBtn = document.getElementById("addressModalSubmit");
    const fields = ["name", "phone", "street", "city", "state", "pincode"];

    // address = undefined -> Add mode, address = { _id, name, ... } -> Edit mode
    window.openAddressModal = function (address) {
      form.reset();
      fields.forEach((f) => clearFieldError(form.elements[f]));

      if (address && address._id) {
        title.textContent = "Edit Address";
        submitBtn.textContent = "Update Address";
        form.action = `/profile/addresses/${address._id}/edit`;
        fields.forEach((f) => { form.elements[f].value = address[f] || ""; });
        form.elements.isDefault.checked = !!address.isDefault;
      } else {
        title.textContent = "Add Delivery Address";
        submitBtn.textContent = "Save Address";
        form.action = "/profile/addresses/add";
      }

      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      form.elements.name.focus();
    };

    window.closeAddressModal = function () {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    };

    // Close on backdrop click or Escape key
    modal.addEventListener("click", (e) => { if (e.target === modal) closeAddressModal(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) closeAddressModal();
    });

    // Same rules as the server (userService.addUserAddress / updateUserAddress)
    const rules = {
      name: [/^[A-Za-z\s]{3,50}$/, "Name must be 3-50 letters only"],
      phone: [/^[6-9]\d{9}$/, "Enter a valid 10-digit number starting with 6-9"],
      street: [/^.{5,100}$/, "Street must be at least 5 characters"],
      city: [/^[A-Za-z\s]{3,50}$/, "City must contain only letters"],
      state: [/^[A-Za-z\s]{3,50}$/, "State must contain only letters"],
      pincode: [/^[1-9][0-9]{5}$/, "Enter a valid 6-digit pincode"]
    };

    form.addEventListener("submit", function (e) {
      let valid = true;
      fields.forEach((f) => {
        const input = form.elements[f];
        const value = input.value.trim();
        if (!value) {
          showFieldError(input, "This field is required");
          valid = false;
        } else if (!rules[f][0].test(value)) {
          showFieldError(input, rules[f][1]);
          valid = false;
        } else {
          clearFieldError(input);
        }
      });
      if (!valid) e.preventDefault();
    });

    function showFieldError(input, message) {
      input.classList.add("border-red-500");
      const err = input.closest(".form-group").querySelector("p");
      err.textContent = message;
      err.classList.remove("hidden");
    }

    function clearFieldError(input) {
      input.classList.remove("border-red-500");
      const err = input.closest(".form-group").querySelector("p");
      err.classList.add("hidden");
    }
  })();
</script>
